+use bevy::prelude::*;
+
+use super::{BOT_COUNT, TEAM_SIZE, VIEW_COUNT};
+
+#[derive(Clone, Copy, Default)]
+pub(super) struct FightView {
+    pub score: f32,
+    pub opponent: Option<u32>,
+    pub aim_degrees: f32,
+    pub visible_samples: u8,
+}
+
+pub(super) fn fight_views(
+    presented: &net::PresentedSnapshot,
+    roster: &bots::BotRoster,
+    clip: Option<&asset_world::ClipCollision>,
+) -> [FightView; VIEW_COUNT] {
+    std::array::from_fn(|id| {
+        let mut result = FightView {
+            score: -1.0,
+            ..default()
+        };
+        let Some(ps) = presented
+            .player(sim::ClientId(id as u32))
+            .filter(|p| id != 0 && p.health > 0 && p.pm_type < 5)
+        else {
+            return result;
+        };
+        result.score = 0.0;
+        let eye = Vec3::from_array(ps.origin) + Vec3::Z * ps.view_height_current;
+        let (sp, cp) = ps.viewangles[0].to_radians().sin_cos();
+        let (sy, cy) = ps.viewangles[1].to_radians().sin_cos();
+        let forward = Vec3::new(cp * cy, cp * sy, -sp);
+        for enemy in 1..=BOT_COUNT as usize {
+            if (enemy <= TEAM_SIZE as usize) == (id <= TEAM_SIZE as usize) {
+                continue;
+            }
+            let Some(other) = presented
+                .player(sim::ClientId(enemy as u32))
+                .filter(|p| p.health > 0 && p.pm_type < 5)
+            else {
+                continue;
+            };
+            let feet = Vec3::from_array(other.origin);
+            let distance = eye.distance(feet);
+            let mut angle = 180.0_f32;
+            let mut visible = 0_u8;
+            for height in [0.5, 0.8, 1.0] {
+                let point = feet + Vec3::Z * other.view_height_current * height;
+                let degrees = forward
+                    .dot((point - eye).normalize_or_zero())
+                    .clamp(-1.0, 1.0)
+                    .acos()
+                    .to_degrees();
+                if degrees > 40.0 {
+                    continue;
+                }
+                if clip.is_some_and(|clip| {
+                    clip.sweep_box(
+                        eye.to_array(),
+                        point.to_array(),
+                        [0.0; 3],
+                        [0.0; 3],
+                        sim::MASK_SHOT & !0x10,
+                    )
+                    .fraction
+                        >= 0.999
+                }) {
+                    visible += 1;
+                    angle = angle.min(degrees);
+                }
+            }
+            let score = if visible > 0 {
+                let centered = (-(angle / 18.0).powi(2)).exp();
+                let firing = roster
+                    .bots
+                    .iter()
+                    .find(|b| b.id.0 == id as u32)
+                    .and_then(|b| b.brain.as_ref())
+                    .is_some_and(|b| b.intent().fire);
+                100.0
+                    + centered * 200.0
+                    + visible as f32 * 12.0
+                    + ps.f_weapon_pos_frac * 20.0
+                    + if firing { 8.0 } else { 0.0 }
+            } else {
+                (30.0 - distance / 100.0).max(0.0)
+            };
+            if score > result.score {
+                result = FightView {
+                    score,
+                    opponent: Some(enemy as u32),
+                    aim_degrees: angle,
+                    visible_samples: visible,
+                };
+            }
+        }
+        result
+    })
+}
+
+#[derive(Default)]
+pub(super) struct Director {
+    candidate: Option<(u32, f32)>,
+}
+
+impl Director {
+    pub fn reset(&mut self) {
+        self.candidate = None;
+    }
+
+    pub fn choose(
+        &mut self,
+        views: &[FightView; VIEW_COUNT],
+        current: u32,
+        now: f32,
+        last_cut: f32,
+    ) -> Option<u32> {
+        let (best, score) = (1..=BOT_COUNT)
+            .map(|id| (id, views[id as usize].score))
+            .max_by(|a, b| a.1.total_cmp(&b.1))?;
+        let active = views[current as usize].score;
+        let margin = if score < 100.0 { 3.0 } else { 35.0 };
+        if best == current
+            || score < 0.0
+            || (current != 0 && active >= 0.0 && score < active + margin)
+        {
+            self.candidate = None;
+            return None;
+        }
+        let (_, since) = *self.candidate.get_or_insert((best, now));
+        if self.candidate.is_some_and(|(id, _)| id != best) {
+            self.candidate = Some((best, now));
+            return None;
+        }
+        let urgent = current == 0 || active < 0.0 || (active < 100.0 && score >= 200.0);
+        let hold = if urgent { 0.6 } else { 1.5 };
+        let settle = if score >= 100.0 { 0.15 } else { 0.8 };
+        if now - last_cut >= hold && now - since >= settle {
+            self.candidate = None;
+            Some(best)
+        } else {
+            None
+        }
+    }
+}
diff --git a/crates/bootstrap/src/bot_match.rs b/crates/bootstrap/src/bot_match.rs
new file mode 100644
index 0000000..90d145b
--- /dev/null
+++ b/crates/bootstrap/src/bot_match.rs
@@ -0,0 +1,334 @@
+//! Opt-in autonomous crossover match and a freely movable spectator camera.
+use bevy::prelude::*;
+#[path = "bot_director.rs"]
+mod director;
+#[path = "bot_portraits.rs"]
+mod portraits;
+use frame::{AppScreen, ClientSet, RenderSet};
+use render_frontend::adapters::anim::fpv_present::{FpvGeometrySet, FpvPlacementSet};
+use render_frontend::{
+    FpvDrawPlan,
+    prepare::scene::camera::{FlyCamera, FpvLens, SimCamera},
+};
+
+const TEAM_SIZE: u32 = 4;
+const BOT_COUNT: u32 = TEAM_SIZE * 2;
+const VIEW_COUNT: usize = BOT_COUNT as usize + 1;
+
+#[derive(Resource, Default)]
+struct BotMatch {
+    started: bool,
+    watching: bool,
+    follow: u32,
+    third_person: bool,
+    auto: bool,
+    last_cut: f32,
+    director: director::Director,
+    views: [director::FightView; VIEW_COUNT],
+    next_evaluation: f32,
+    overview: Option<Transform>,
+}
+
+pub(crate) fn install(app: &mut App) {
+    if std::env::var_os("IW4L_BOT_MATCH").is_none() {
+        return;
+    }
+    app.init_resource::<BotMatch>()
+        .init_resource::<net::LiveSpectatorTarget>();
+    app.world_mut()
+        .resource_mut::<console::ConsoleRegistry>()
+        .register(
+            console::CommandSpec::new("watch")
+                .usage("watch next|overview|1..8|third|first|toggle|auto|manual|status — native bot spectator view"),
+        );
+    app.add_systems(Update, (setup, cycle_view).chain().in_set(ClientSet::Input));
+    portraits::install(app);
+    app.add_systems(
+        Update,
+        camera
+            .in_set(ClientSet::Present)
+            .before(RenderSet::FrontendPrepare),
+    );
+    app.add_systems(
+        Update,
+        hide_viewmodel
+            .in_set(ClientSet::Present)
+            .after(FpvGeometrySet)
+            .after(FpvPlacementSet)
+            .after(frame::WorkerCmdSet::AddSceneEnt)
+            .in_set(render_frontend::assemble::ViewmodelDrawReady),
+    );
+}
+
+fn setup(
+    screen: Res<AppScreen>,
+    mut state: ResMut<BotMatch>,
+    mut queue: ResMut<console::ConsoleQueue>,
+    world: Option<Res<net::AuthorityWorld>>,
+    local: Res<net::LocalPresentClient>,
+    mut actions: ResMut<net::ClientActionInbox>,
+    mut ids: ResMut<net::ActionRequestIds>,
+    mut cameras: Query<(&mut Transform, &mut FlyCamera)>,
+) {
+    if !state.started {
+        if *screen != AppScreen::InGame {
+            return;
+        }
+        queue.push_line(&format!(
+            "bot quickscope {TEAM_SIZE}; bot spartan {TEAM_SIZE}"
+        ));
+        state.started = true;
+    }
+    if state.watching {
+        return;
+    }
+    let Some(world) = world else {
+        return;
+    };
+    if world.0.player_count() < VIEW_COUNT {
+        return;
+    }
+    let action = sim::ClientAction::MenuResponse {
+        request_id: ids.allocate(),
+        menu: sim::menu_response_field("team_marinesopfor").unwrap(),
+        response: sim::menu_response_field("spectator").unwrap(),
+    };
+    if actions.push(local.0, action).is_err() {
+        return;
+    }
+    let points = world.0.authored_spawn_origins();
+    let mut lo = Vec3::splat(f32::MAX);
+    let mut hi = Vec3::splat(f32::MIN);
+    for p in points {
+        let p = Vec3::from_array(p);
+        lo = lo.min(p);
+        hi = hi.max(p);
+    }
+    if lo.is_finite() && hi.is_finite() && lo.x <= hi.x {
+        let center = (lo + hi) * 0.5;
+        let eye = center + Vec3::new(-600.0, -1000.0, 1500.0);
+        let overview = Transform::from_translation(eye).looking_at(center, Vec3::Z);
+        state.overview = Some(overview);
+        for (mut pose, mut fly) in &mut cameras {
+            *pose = overview;
+            fly.pitch = 0.0;
+            fly.yaw = 0.0;
+        }
+    }
+    state.watching = true;
+    diag::info!(
+        Launch,
+        "BOT MATCH: autonomous 4v4 active; click/F6 cycles eight player views + overview; F5 overview; V/F7 first/third person; X auto-director; WASD/QE fly, arrows turn"
+    );
+}
+
+fn cycle_view(
+    mut state: ResMut<BotMatch>,
+    keys: Res<ButtonInput<KeyCode>>,
+    mouse: Res<ButtonInput<MouseButton>>,
+    screen: Res<AppScreen>,
+    mut windows: Query<&mut Window, With<bevy::window::PrimaryWindow>>,
+    mut commands: MessageReader<console::ConsoleCommand>,
+    mut lenses: Query<&mut Projection, With<FpvLens>>,
+    mut target: ResMut<net::LiveSpectatorTarget>,
+    mut sim_camera: ResMut<SimCamera>,
+    mut cameras: Query<&mut Transform, With<FlyCamera>>,
+    time: Res<Time>,
+    roster: Res<bots::BotRoster>,
+    presented: Res<net::PresentedSnapshot>,
+    clip: Res<render_frontend::adapters::anim::dyn_ent::DynEntPhysClip>,
+    scene_view: Res<render_frontend::prepare::scene::view_parms::PreparedSceneView>,
+    bodies: Query<(&net::CEntity, &Transform), Without<FlyCamera>>,
+) {
+    if !state.watching || *screen != AppScreen::InGame {
+        return;
+    }
+    let mut cycle = mouse.just_pressed(MouseButton::Left) || keys.just_pressed(KeyCode::F6);
+    let mut direct = keys.just_pressed(KeyCode::F5).then_some(0);
+    let now = time.elapsed_secs();
+    let mut auto = keys.just_pressed(KeyCode::KeyX).then_some(!state.auto);
+    let mut status = false;
+    let mut perspective = (keys.just_pressed(KeyCode::KeyV) || keys.just_pressed(KeyCode::F7))
+        .then_some(!state.third_person);
+    for command in commands.read().filter(|command| command.name == "watch") {
+        match command.args.first().map(String::as_str) {
+            Some("next") | None => cycle = true,
+            Some("overview") | Some("0") => direct = Some(0),
+            Some("third") => perspective = Some(true),
+            Some("first") => perspective = Some(false),
+            Some("toggle") => perspective = Some(!state.third_person),
+            Some("auto") => auto = Some(true),
+            Some("manual") => auto = Some(false),
+            Some("status") => status = true,
+            Some(value) => match value.parse::<u32>() {
+                Ok(n @ 1..=BOT_COUNT) => direct = Some(n),
+                _ => diag::warn!(
+                    Launch,
+                    "usage: watch next|overview|1..8|third|first|toggle|auto|manual|status"
+                ),
+            },
+        }
+    }
+    if let Some(enabled) = auto {
+        state.auto = enabled;
+        state.director.reset();
+        state.last_cut = now - 3.0;
+    }
+    if cycle || direct.is_some() {
+        state.auto = false;
+        state.director.reset();
+        state.last_cut = now;
+    }
+    if (state.auto && now >= state.next_evaluation) || status {
+        state.views = director::fight_views(&presented, &roster, clip.0.as_deref());
+        state.next_evaluation = now + 0.1;
+    }
+    if state.auto {
+        let views = state.views;
+        let current = state.follow;
+        let last_cut = state.last_cut;
+        if let Some(id) = state.director.choose(&views, current, now, last_cut) {
+            direct = Some(id);
+            state.last_cut = now;
+            let view = views[id as usize];
+            diag::info!(
+                Launch,
+                "BOT DIRECTOR: {} -> {} score={:.1}->{:.1} enemy={:?} aim={:.1} visible={}/3",
+                current,
+                id,
+                views[current as usize].score,
+                view.score,
+                view.opponent,
+                view.aim_degrees,
+                view.visible_samples
+            );
+        }
+    }
+    if let Some(third) = perspective {
+        state.third_person = third;
+    }
+    if cycle {
+        state.follow = (state.follow + 1) % VIEW_COUNT as u32;
+    }
+    if let Some(n) = direct {
+        state.follow = n;
+    }
+    if state.follow == 0 && (cycle || direct.is_some()) {
+        for mut projection in &mut lenses {
+            if let Projection::Perspective(p) = &mut *projection {
+                p.fov = 60.0_f32.to_radians();
+            }
+        }
+        if let Some(overview) = state.overview {
+            for mut pose in &mut cameras {
+                *pose = overview;
+            }
+        }
+    }
+    if status {
+        if let Some(ps) = presented.player(sim::ClientId(state.follow)) {
+            for pose in &mut cameras {
+                diag::info!(
+                    Launch,
+                    "BOT CAMERA: follow={} third={} auto={} health={} feet={:?} height={} angles={:?} eye={:?} direction={:?}",
+                    state.follow,
+                    state.third_person,
+                    state.auto,
+                    ps.health,
+                    ps.origin,
+                    ps.view_height_current,
+                    ps.viewangles,
+                    pose.translation,
+                    pose.forward()
+                );
+            }
+        }
+        for (entity, pose) in &bodies {
+            if entity.number() as u32 == state.follow {
+                let feet = pose.translation;
+                let head = feet + Vec3::Z * 70.0;
+                diag::info!(
+                    Launch,
+                    "BOT FRAMING: body={:?} render_eye={:?} render_forward={:?} vertical_fov={:.1} feet_ndc={:?} head_ndc={:?}",
+                    feet,
+                    scene_view.eye,
+                    scene_view.forward,
+                    scene_view.fov.to_degrees(),
+                    scene_view.clip_from_world.project_point3(feet),
+                    scene_view.clip_from_world.project_point3(head)
+                );
+            }
+        }
+        for id in 1..VIEW_COUNT {
+            let view = state.views[id];
+            diag::info!(
+                Launch,
+                "BOT SIGHT: id={} score={:.1} enemy={:?} aim={:.1} visible={}/3",
+                id,
+                view.score,
+                view.opponent,
+                view.aim_degrees,
+                view.visible_samples
+            );
+        }
+        for bot in &roster.bots {
+            if let Some(brain) = &bot.brain {
+                let cmd = brain.last_cmd();
+                if let Some(ps) = presented.player(bot.id) {
+                    diag::info!(
+                        Launch,
+                        "BOT INPUT: id={} hp={} position={:?} velocity={:?} ground={} ads={} move=({}, {}) buttons={} task={:?}",
+                        bot.id.0,
+                        ps.health,
+                        ps.origin,
+                        ps.velocity,
+                        ps.ground_entity_num,
+                        ps.f_weapon_pos_frac,
+                        cmd.forwardmove,
+                        cmd.rightmove,
+                        cmd.buttons,
+                        brain.task()
+                    );
+                }
+            }
+        }
+    }
+    target.0 = (state.follow != 0).then_some(sim::ClientId(state.follow));
+    target.1 = state.third_person;
+    sim_camera.enabled = state.follow != 0;
+    sim_camera.freeze_fly = state.follow != 0;
+    if cycle || direct.is_some() || perspective.is_some() || auto.is_some() {
+        let label = if state.follow == 0 {
+            "overview".to_owned()
+        } else if state.follow <= TEAM_SIZE {
+            format!("MW2 soldier {}", state.follow)
+        } else {
+            format!("Spartan {}", state.follow - TEAM_SIZE)
+        };
+        for mut window in &mut windows {
+            window.title = format!(
+                "iw4l — Halo / MW2 4v4 — {label} | click: next · V: first/third · X: auto-director"
+            );
+        }
+        diag::info!(
+            Launch,
+            "BOT VIEW: {label}; third_person={}; auto={}",
+            state.third_person,
+            state.auto
+        );
+    }
+}
+
+fn camera(state: Res<BotMatch>, mut camera: ResMut<SimCamera>) {
+    if state.watching {
+        camera.enabled = state.follow != 0;
+        camera.freeze_fly = state.follow != 0;
+    }
+}
+
+fn hide_viewmodel(state: Res<BotMatch>, mut plan: ResMut<FpvDrawPlan>) {
+    if state.watching && (state.follow == 0 || state.third_person) {
+        plan.drawgun = Some(0);
+        plan.visible = false;
+    }
+}
diff --git a/crates/bootstrap/src/bot_portraits.rs b/crates/bootstrap/src/bot_portraits.rs
new file mode 100644
index 0000000..2909a6f
--- /dev/null
+++ b/crates/bootstrap/src/bot_portraits.rs
@@ -0,0 +1,135 @@
+use bevy::prelude::*;
+
+use super::{BotMatch, TEAM_SIZE};
+
+#[derive(Resource, Default)]
+struct Portraits(Option<[Handle<Image>; 2]>);
+#[derive(Component)]
+struct Badge;
+#[derive(Component)]
+struct Bust;
+#[derive(Component)]
+struct Caption;
+
+pub(super) fn install(app: &mut App) {
+    app.init_resource::<Portraits>();
+    app.add_systems(
+        Update,
+        (prepare, refresh).chain().in_set(frame::ClientSet::Present),
+    );
+}
+
+fn prepare(
+    mut commands: Commands,
+    state: Res<BotMatch>,
+    bodies: Option<Res<assets::PreparedBodies>>,
+    mut portraits: ResMut<Portraits>,
+    mut images: ResMut<Assets<Image>>,
+    font: Res<ui::GameUiFont>,
+) {
+    if !state.watching || portraits.0.is_some() {
+        return;
+    }
+    let Some(bodies) = bodies else {
+        return;
+    };
+    let (Some(soldier), Some(spartan)) = (bodies.1[0].clone(), bodies.1[1].clone()) else {
+        return;
+    };
+    let handles = [images.add(soldier), images.add(spartan)];
+    portraits.0 = Some(handles.clone());
+    commands
+        .spawn((
+            Badge,
+            Node {
+                position_type: PositionType::Absolute,
+                left: Val::Percent(27.0),
+                bottom: Val::Percent(3.5),
+                height: Val::Px(44.0),
+                width: Val::Px(185.0),
+                align_items: AlignItems::Center,
+                column_gap: Val::Px(6.0),
+                padding: UiRect::right(Val::Px(12.0)),
+                ..default()
+            },
+            GlobalZIndex(50),
+            BackgroundColor(Color::srgba(0.025, 0.04, 0.055, 0.8)),
+        ))
+        .with_children(|parent| {
+            parent.spawn((
+                Bust,
+                ImageNode::new(handles[0].clone()),
+                Node {
+                    width: Val::Px(40.0),
+                    height: Val::Px(44.0),
+                    flex_shrink: 0.0,
+                    ..default()
+                },
+            ));
+            parent.spawn((
+                Caption,
+                Text::new(""),
+                ui::game_text_font(&font.0, 9.0),
+                TextColor(Color::srgb(0.92, 0.95, 0.98)),
+            ));
+        });
+}
+
+fn refresh(
+    state: Res<BotMatch>,
+    screen: Res<frame::AppScreen>,
+    portraits: Res<Portraits>,
+    snapshot: Res<net::PresentedSnapshot>,
+    mut badges: Query<(&mut Node, &mut BackgroundColor), With<Badge>>,
+    mut busts: Query<(&mut Node, &mut ImageNode), (With<Bust>, Without<Badge>)>,
+    mut captions: Query<&mut Text, With<Caption>>,
+) {
+    let spartan = state.follow > TEAM_SIZE;
+    for (mut node, mut color) in &mut badges {
+        node.display = if state.watching && *screen == frame::AppScreen::InGame {
+            Display::Flex
+        } else {
+            Display::None
+        };
+        color.0 = if spartan {
+            Color::srgba(0.025, 0.08, 0.18, 0.82)
+        } else {
+            Color::srgba(0.07, 0.085, 0.035, 0.82)
+        };
+    }
+    for (mut node, mut image) in &mut busts {
+        node.display = if state.follow == 0 {
+            Display::None
+        } else {
+            Display::Flex
+        };
+        if let Some(handles) = &portraits.0 {
+            image.image = handles[usize::from(spartan)].clone();
+        }
+    }
+    let name = snapshot
+        .snapshot()
+        .and_then(|s| s.meta.for_client(sim::ClientId(state.follow)))
+        .map(|meta| {
+            String::from_utf8_lossy(&meta.name)
+                .trim_end_matches('\0')
+                .to_owned()
+        })
+        .unwrap_or_else(|| format!("Player {}", state.follow));
+    let label = if state.follow == 0 {
+        "  BATTLEFIELD OVERVIEW\n  Click: next · X: auto".to_owned()
+    } else {
+        format!(
+            "{name}\n{} · {} PERSON{}\nV: camera · X: {}",
+            if spartan { "SPARTAN" } else { "COD" },
+            if state.third_person { "3RD" } else { "1ST" },
+            if state.auto { " · AUTO" } else { "" },
+            if state.auto { "manual" } else { "auto" }
+        )
+    };
+    for mut caption in &mut captions {
+        if caption.0 != label {
+            caption.0 = label.clone();
+        }
+    }
+}
diff --git a/crates/bootstrap/src/cinema.rs b/crates/bootstrap/src/cinema.rs
new file mode 100644
index 0000000..1de253f
--- /dev/null
+++ b/crates/bootstrap/src/cinema.rs
@@ -0,0 +1,89 @@
+//! Local JSON take driver. Uses the native simulation, animation and Metal renderer.
+use bevy::prelude::*;
+use frame::{AppScreen, ClientSet, RenderSet, UiDraw};
+use render_frontend::{FpvDrawPlan,prepare::scene::camera::{FlyCamera,FpvLens,SimCamera}};
+use render_frontend::adapters::anim::fpv_present::{FpvGeometrySet,FpvPlacementSet};
+use serde_json::Value;
+
+#[derive(Resource)]
+struct Take {
+    duration:f32, setup:String, events:Vec<(f32,String)>, camera:Vec<[f32;8]>,
+    motion:Vec<Vec<[f32;3]>>, stage:u8, stamp:f32, time:f32, cue:usize,
+}
+pub(crate) fn install(app:&mut App) {
+    let Some(path)=std::env::var_os("IW4L_CINEMA") else{return;};
+    let v:Value=serde_json::from_slice(&std::fs::read(path).expect("read native scene")).expect("parse native scene");
+    if v["version"]==2 {crate::cinema2::install(app,v);return;}
+    assert_eq!(v["version"],1,"native scene version");
+    let duration=v["duration"].as_f64().expect("scene duration") as f32;
+    assert!(duration.is_finite() && duration>0. && duration<=300.);
+    let camera:Vec<[f32;8]>=serde_json::from_value(v["camera"].clone()).expect("camera samples");
+    assert!(camera.len()>=(duration*60.) as usize+1 && camera.iter().flatten().all(|x|x.is_finite()));
+    let motion:Vec<Vec<[f32;3]>>=serde_json::from_value(v["motion"].clone()).expect("actor samples");
+    assert!(!motion.is_empty() && motion.iter().all(|f|f.len()==16 && f.iter().flatten().all(|x|x.is_finite())));
+    let events=v["events"].as_array().expect("scene events").iter().map(|e|(e["at"].as_f64().expect("cue time") as f32,e["command"].as_str().expect("cue command").to_owned())).collect();
+    app.insert_resource(Take{duration,setup:v["setup"].as_str().expect("scene setup").into(),events,camera,motion,stage:0,stamp:0.,time:0.,cue:0});
+    app.add_systems(Update,drive.in_set(ClientSet::Input));
+    app.add_systems(Update,move_camera.in_set(ClientSet::Present).before(RenderSet::FrontendPrepare));
+    app.add_systems(Update,hide_viewmodel.in_set(ClientSet::Present)
+        .after(FpvGeometrySet).after(FpvPlacementSet)
+        .after(frame::WorkerCmdSet::AddSceneEnt)
+        .in_set(render_frontend::assemble::ViewmodelDrawReady));
+}
+fn drive(time:Res<Time<Real>>,keys:Res<ButtonInput<KeyCode>>,screen:Res<AppScreen>,mut take:ResMut<Take>,mut queue:ResMut<console::ConsoleQueue>,mut world:Option<ResMut<net::AuthorityWorld>>,mut sim_camera:ResMut<SimCamera>,mut ui:ResMut<UiDraw>) {
+    let now=time.elapsed_secs();
+    if take.stage>=3 && keys.just_pressed(KeyCode::F9) {
+        let p=take.motion[0][0];
+        queue.push_line(&format!("release +speed_throw; force_spawn at {} {} {} 0; wait 0.5s; {}",p[0],p[1],p[2],take.setup));
+        take.stage=2;take.stamp=now;take.time=0.;sim_camera.enabled=true;ui.0=true;return;
+    }
+    if take.stage==0 {
+        if *screen!=AppScreen::InGame{return;}
+        queue.push_line("bot dummy 15");take.stage=1;take.stamp=now;return;
+    }
+    if take.stage==1 {
+        if !world.as_ref().is_some_and(|w|w.0.player_count()>=16) || now-take.stamp<2. {return;}
+        queue.push_line(&take.setup);take.stage=2;take.stamp=now;return;
+    }
+    if take.stage==2 {
+        if now-take.stamp<5. {return;}
+        take.stage=3;take.stamp=now;take.cue=0;ui.0=true;
+        diag::info!(Launch,"NATIVE CINEMA: starting 24-second take; 8 MW2 soldiers + 8 CE Spartans");
+    }
+    take.time=(now-take.stamp).min(take.duration);
+    sim_camera.enabled=take.time<5.8;sim_camera.freeze_fly=true;
+    if take.time>=5.8{ui.0=false;}
+    while take.cue<take.events.len() && take.events[take.cue].0<=take.time {
+        queue.push_line(&take.events[take.cue].1);take.cue+=1;
+    }
+    if let Some(world)=world.as_mut(){
+        let f=((take.time*10.) as usize).min(take.motion.len()-1);
+        for id in 1..16 {
+            world.0.cinema_keep_alive(sim::ClientId(id));
+            world.0.set_origin(sim::ClientId(id),take.motion[f][id as usize]);
+        }
+        if take.time<5.4 {world.0.cinema_keep_alive(sim::ClientId(0));}
+    }
+    if take.stage==3 && take.time>=take.duration {
+        take.stage=4;queue.push_line("screenshot");
+        diag::info!(Launch,"NATIVE CINEMA: take complete, holding final camera");
+    }
+}
+fn move_camera(take:Res<Take>,mut cameras:Query<&mut Transform,With<FlyCamera>>,mut lenses:Query<&mut Projection,With<FpvLens>>) {
+    if take.stage<3 || take.time<5.8{return;}
+    let sample=(take.time*60.).min((take.camera.len()-1) as f32);
+    let i=sample.floor() as usize;let a=take.camera[i];let b=take.camera[(i+1).min(take.camera.len()-1)];let u=sample-i as f32;
+    let p=std::array::from_fn::<_,8,_>(|k|a[k]+(b[k]-a[k])*u);
+    let mut pose=Transform::from_xyz(p[0],p[1],p[2]).looking_at(Vec3::new(p[3],p[4],p[5]),Vec3::Z);
+    pose.rotate_local_z(p[7]);
+    for mut camera in &mut cameras{*camera=pose;}
+    for mut projection in &mut lenses{if let Projection::Perspective(lens)=&mut *projection{lens.fov=p[6].to_radians();}}
+}
+fn hide_viewmodel(take:Res<Take>,mut plan:ResMut<FpvDrawPlan>){
+    if take.stage>=3 && take.time>=5.8 {
+        // Lighting finalization recomputes visible; preserve the decision in
+        // drawgun so it survives the rest of the native render pipeline.
+        plan.drawgun=Some(0);
+        plan.visible=false;
+    }
+}
