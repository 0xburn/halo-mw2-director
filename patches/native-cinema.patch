+        let fv = integer(&row["first_vertex"])?;
+        let vc = integer(&row["vertex_count"])?;
+        let fi = integer(&row["first_index"])?;
+        let ic = integer(&row["index_count"])?;
+        let mi = integer(&row["material"])?;
+        if vc == 0
+            || fv + vc > n
+            || fi + ic > draw.packed_indices.len()
+            || ic % 3 != 0
+            || ic / 3 > 65535
+            || mi >= map_materials.len()
+        {
+            return Err("invalid local map surface range".into());
+        }
+        if draw.packed_indices[fi..fi + ic]
+            .iter()
+            .any(|v| (*v as usize) < fv || (*v as usize) >= fv + vc)
+        {
+            return Err("surface vertex outside range".into());
+        }
+        draw.surface_first_vertex.push(fv as u32);
+        draw.surface_draw_fields.push(SurfaceDrawFields {
+            first_vertex: fv as u32,
+            tri_count: (ic / 3) as u16,
+            base_index: fi as u32,
+            lightmap_index: 255,
+            reflection_probe_index: 0,
+            primary_light_index: 0,
+        });
+        draw.surface_index_ranges.push((fi as u32, ic as u32));
+        draw.surface_materials.push(Some(map_materials[mi]));
+        draw.surface_lightmapped.push(false);
+        draw.surface_lightmap_indices.push(255);
+        draw.surface_reflection_probes.push(0);
+        draw.surface_primary_lights.push(0);
+        draw.dpvs
+            .surface_bounds
+            .push(bounds(&draw.positions[fv..fv + vc]));
+    }
+    (draw.batches, draw.surface_batch_ranges) = make_material_batches(
+        &draw.positions,
+        &draw.normals,
+        &draw.tangents,
+        &draw.colors,
+        &draw.texture_uvs,
+        &draw.lightmap_uvs,
+        &draw.packed_indices,
+        &draw.surface_index_ranges,
+        &draw.surface_materials,
+        &draw.surface_lightmapped,
+        &draw.surface_lightmap_indices,
+        &draw.surface_primary_lights,
+        &draw.surface_reflection_probes,
+    );
+    let all_bounds = bounds(&draw.positions);
+    draw.dpvs.cell_count = 1;
+    draw.dpvs.nodes = vec![1];
+    draw.dpvs.cell_roots = vec![SurfRange {
+        start: 0,
+        count: count as u16,
+    }];
+    draw.dpvs.sorted_surf_index = (0..count as u16).collect();
+    draw.dpvs.static_surface_count = count;
+    draw.dpvs.static_surface_count_no_decal = count;
+    draw.dpvs.emissive_surfs_begin = 0;
+    draw.dpvs.emissive_surfs_end = 0;
+    draw.dpvs.lit_opaque_begin = 0;
+    draw.dpvs.lit_opaque_end = count as u32;
+    draw.dpvs.aabb_trees = vec![vec![AabbNodeView {
+        bounds: all_bounds,
+        child_count: 0,
+        children_offset: 0,
+        start_surf: 0,
+        surface_count: count as u16,
+        start_surf_no_decal: 0,
+        surface_count_no_decal: count as u16,
+        smodel_index_start: 0,
+        smodel_index_count: 0,
+    }]];
+    draw.dpvs.aabb_smodel_indices = vec![Vec::new()];
+    draw.dpvs.portals_per_cell = vec![Vec::new()];
+    draw.dpvs.cell_reflection_probes = vec![Vec::new()];
+    draw.capture = world_capture_from_casters(SurfaceCastsSunShadow::with_len(count));
+    let limits = array3(&pack["bounds"])?;
+    if limits.len() != 2 {
+        return Err("invalid local map bounds".into());
+    }
+    let (min, max) = (limits[0], limits[1]);
+    let world_bounds = Some([min[0], min[1], min[2], max[0], max[1], max[2]]);
+    draw.stats = WorldMeshStats {
+        vertices: n,
+        triangles: draw.packed_indices.len() / 3,
+        surfaces: count,
+        min,
+        max,
+        bounds: world_bounds,
+        ..Default::default()
+    };
+    let clip = collision(&pack["collision"])?;
+    let mut spawns = Vec::new();
+    let mut entities = String::from("{\n\"classname\" \"worldspawn\"\n}\n");
+    let spawn_rows = pack["spawns"].as_array().ok_or("missing local spawns")?;
+    let outdoors = |row: &&serde_json::Value| -> bool {
+        let Ok(p) = serde_json::from_value::<[f32; 3]>(row["origin"].clone()) else {
+            return false;
+        };
+        clip.box_sight_clear(
+            [p[0], p[1], p[2] + 64.0],
+            [p[0], p[1], p[2] + 640.0],
+            asset_world::MASK_PLAYER_SOLID,
+        )
+    };
+    let use_outdoors = std::env::var_os("IW4L_BOT_MATCH").is_some()
+        && spawn_rows.iter().filter(outdoors).count() >= 4;
+    for row in spawn_rows {
+        if use_outdoors && !outdoors(&row) {
+            continue;
+        }
+        let mut origin: [f32; 3] =
+            serde_json::from_value(row["origin"].clone()).map_err(|e| e.to_string())?;
+        let angles: [f32; 3] =
+            serde_json::from_value(row["angles"].clone()).map_err(|e| e.to_string())?;
+        if origin.iter().chain(angles.iter()).any(|v| !v.is_finite()) {
+            return Err("non-finite spawn".into());
+        }
+        origin[2] += 4.;
+        for classname in [
+            "mp_dm_spawn",
+            "mp_dm_spawn_start",
+            "mp_tdm_spawn",
+            if row["team"].as_u64().unwrap_or(0) == 1 {
+                "mp_tdm_spawn_allies_start"
+            } else {
+                "mp_tdm_spawn_axis_start"
+            },
+        ] {
+            entities.push_str(&format!("{{\n\"classname\" \"{classname}\"\n\"origin\" \"{} {} {}\"\n\"angles\" \"{} {} {}\"\n}}\n",origin[0],origin[1],origin[2],angles[0],angles[1],angles[2]));
+            spawns.push(SpawnPoint {
+                classname: classname.into(),
+                origin,
+                angles,
+                script_linkto: String::new(),
+                script_destructable_area: String::new(),
+            });
+        }
+    }
+    if spawns.is_empty() {
+        return Err("local map has no spawn points".into());
+    }
+    let first = &spawns[0];
+    entities.push_str(&format!("{{\n\"classname\" \"mp_global_intermission\"\n\"origin\" \"{} {} {}\"\n\"angles\" \"{} {} {}\"\n}}\n", first.origin[0], first.origin[1], first.origin[2]+60., first.angles[0], first.angles[1], first.angles[2]));
+    let intermission = Some(IntermissionView {
+        origin: [first.origin[0], first.origin[1], first.origin[2] + 60.],
+        angles: first.angles,
+    });
+    let impact_fx = prepared.world.impact_fx.take();
+    let primary_light = prepared.world.dynamic_light.take();
+    let reflection_probe_images = std::mem::take(&mut prepared.world.reflection_probe_images);
+    prepared.world = crate::PreparedWorld {
+        reflection_probe_images,
+        draw: Some(draw),
+        min,
+        max,
+        world_bounds,
+        intermission_view: intermission,
+        film_vision: Some(FilmVision::default()),
+        exp_fog: Some(ExpFog {
+            start_dist: 100000.,
+            halfway_dist: 1000000.,
+            color_rgb: [0.62, 0.64, 0.8],
+            max_opacity: 0.,
+            transition_time: 0.,
+            sun: None,
+            volumetric: None,
+        }),
+        light_grid: Some(asset_model::OwnedLightGrid {
+            mins: [0; 3],
+            maxs: [0; 3],
+            row_axis: 0,
+            col_axis: 1,
+            color_count: 1,
+            has_light_regions: false,
+            sun_primary_light_index: 1,
+            row_data_start: vec![255, 255],
+            raw_row_data: Vec::new(),
+            entries: Vec::new(),
+            colors: vec![180; lighting_iw4::LIGHT_GRID_COLORS_BYTE_COUNT],
+            color_encoding: asset_model::LightGridColorEncoding::Rgb8,
+        }),
+        impact_fx,
+        dynamic_light: primary_light,
+        ..Default::default()
+    };
+    prepared.clip = Some(Arc::new(clip));
+    prepared.prepared_map.spawns = spawns;
+    prepared.prepared_map.facts.minimap_corners = None;
+    prepared.prepared_map.facts.script_sound.ambient_alias = None;
+    if let Some(Ok(sound)) = prepared.sound.as_mut() {
+        sound.rawfiles.retain(|(_, path), _| {
+            !matches!(
+                path.as_str(),
+                "maps/createfx/mp_rust_fx.gsc" | "maps/mp/mp_rust_fx.gsc"
+            )
+        });
+    }
+    prepared.prepared_map.facts.compass = Default::default();
+    prepared.prepared_map.facts.objective_visuals = Default::default();
+    prepared.scripts.set_entities(entities);
+    prepared.scripts.insert_source(
+        "maps/mp/mp_rust",
+        "main() { maps\\mp\\_load::main(); }".into(),
+    );
+    diag::info!(
+        World,
+        "local map {name}: {n} vertices, {count} surfaces, {} spawn records",
+        prepared.prepared_map.spawns.len()
+    );
+    Ok(())
+}
+
+fn collision(pack: &Value) -> Result<ClipCollision, String> {
+    let verts = array3(&pack["positions"])?;
+    let indices: Vec<u16> =
+        serde_json::from_value(pack["indices"].clone()).map_err(|e| e.to_string())?;
+    if verts.is_empty()
+        || verts.len() > 65535
+        || indices.is_empty()
+        || indices.len() % 3 != 0
+        || indices.iter().any(|i| usize::from(*i) >= verts.len())
+    {
+        return Err("invalid local map collision".into());
+    }
+    let mut triangles: Vec<[u16; 3]> = indices
+        .chunks_exact(3)
+        .map(|v| [v[0], v[1], v[2]])
+        .collect();
+    triangles.sort_by(|a, b| {
+        let center = |t: &[u16; 3]| {
+            (verts[t[0] as usize][0] + verts[t[1] as usize][0] + verts[t[2] as usize][0]) / 3.
+        };
+        center(a).total_cmp(&center(b))
+    });
+    let mut mesh = clipmap_iw4::ClipMeshTables {
+        verts,
+        ..Default::default()
+    };
+    for group in triangles.chunks(32) {
+        let positions: Vec<_> = group
+            .iter()
+            .flatten()
+            .map(|i| mesh.verts[*i as usize])
+            .collect();
+        let b = bounds(&positions);
+        mesh.aabb_roots.push(mesh.aabb_trees.len() as u16);
+        mesh.aabb_trees.push(clipmap_iw4::ClipAabbNode {
+            origin: b.mid(),
+            half_size: b.half(),
+            material_index: 0,
+            child_count: 0,
+            u: mesh.partitions.len() as i32,
+        });
+        mesh.partitions.push(clipmap_iw4::ClipPartition {
+            tri_count: group.len() as u8,
+            first_tri: (mesh.tri_indices.len() / 3) as i32,
+            ..Default::default()
+        });
+        mesh.tri_indices.extend(group.iter().flatten());
+    }
+    let n = mesh.tri_count();
+    mesh.tri_surface_flags = vec![0; n];
+    mesh.tri_content_flags = vec![1; n];
+    mesh.tri_edge_is_walkable = vec![255; (n * 3).div_ceil(8)];
+    let b = bounds(&mesh.verts);
+    Ok(ClipCollision {
+        mesh: Arc::new(mesh),
+        tri_material_index: vec![0; n],
+        materials: vec![ClipMapMaterial {
+            name: "halo_level".into(),
+            surface_flags: 0,
+            content_flags: 1,
+        }],
+        cmodels: vec![ClipCmodel {
+            mins: b.mins(),
+            maxs: b.maxs(),
+            radius: 10000.,
+            first_brush: 0,
+            num_brushes: 0,
+        }],
+        ..Default::default()
+    })
+}
+
+const fn sm3_instruction(opcode: u16, operands: u8) -> u32 {
+    opcode as u32 | ((operands as u32) << 24)
+}
+
+fn water_program() -> Vec<u32> {
+    let mut words = vec![
+        0xffff0300,
+        sm3_instruction(0x1f, 2),
+        0x80000005,
+        0x900f0000,
+        sm3_instruction(0x1f, 2),
+        0x90000000,
+        0xa00f0800,
+    ];
+    for (register, values) in [
+        (221, [0.012f32, -0.020, 0.45, 0.55]),
+        (222, [1.83f32, 1.83, 0.0, 0.0]),
+        (223, [-0.018f32, 0.009, 0.0, 0.0]),
+    ] {
+        words.extend([sm3_instruction(0x51, 5), 0xa00f0000 | register]);
+        words.extend(values.map(f32::to_bits));
+    }
+    words.extend([
+        sm3_instruction(0x04, 4),
+        0x80030000,
+        0xa0ff00dc,
+        0xa0e400dd,
+        0x90e40000,
+        sm3_instruction(0x42, 3),
+        0x800f0001,
+        0x80e40000,
+        0xa0e40800,
+        sm3_instruction(0x05, 3),
+        0x80030000,
+        0x90e40000,
+        0xa0e400de,
+        sm3_instruction(0x04, 4),
+        0x80030000,
+        0xa0ff00dc,
+        0xa0e400df,
+        0x80e40000,
+        sm3_instruction(0x42, 3),
+        0x800f0002,
+        0x80e40000,
+        0xa0e40800,
+        sm3_instruction(0x05, 3),
+        0x800f0001,
+        0x80e40001,
+        0xa0aa00dd,
+        sm3_instruction(0x04, 4),
+        0x800f0800,
+        0x80e40002,
+        0xa0ff00dd,
+        0x80e40001,
+        0x0000ffff,
+    ]);
+    words
+}
+
+fn mip_chain(
+    mut pixels: Vec<u8>,
+    mut width: usize,
+    mut height: usize,
+    cutout: bool,
+) -> (Vec<u8>, u32) {
+    let linear: [f32; 256] = std::array::from_fn(|i| (i as f32 / 255.0).powf(2.2));
+    let coverage =
+        pixels.chunks_exact(4).filter(|p| p[3] >= 128).count() as f32 / (width * height) as f32;
+    let mut level = pixels.clone();
+    let mut levels = 1;
+    while width > 1 || height > 1 {
+        let (w, h) = ((width / 2).max(1), (height / 2).max(1));
+        let mut next = vec![0u8; w * h * 4];
+        for y in 0..h {
+            for x in 0..w {
+                let mut sum = [0f32; 4];
+                for dy in 0..2 {
+                    for dx in 0..2 {
+                        let i = (((y * 2 + dy).min(height - 1)) * width
+                            + (x * 2 + dx).min(width - 1))
+                            * 4;
+                        let alpha = level[i + 3] as f32 / 255.0;
+                        for k in 0..3 {
+                            sum[k] += linear[level[i + k] as usize] * alpha;
+                        }
+                        sum[3] += alpha;
+                    }
+                }
+                let i = (y * w + x) * 4;
+                if sum[3] > 0.0 {
+                    for k in 0..3 {
+                        next[i + k] = ((sum[k] / sum[3]).powf(1.0 / 2.2) * 255.0).round() as u8;
+                    }
+                }
+                next[i + 3] = (sum[3] * 63.75).round() as u8;
+            }
+        }
+        if cutout {
+            let (mut low, mut high) = (0.0f32, 4.0f32);
+            for _ in 0..10 {
+                let scale = (low + high) * 0.5;
+                let visible = next
+                    .chunks_exact(4)
+                    .filter(|p| p[3] as f32 * scale >= 128.0)
+                    .count() as f32
+                    / (w * h) as f32;
+                if visible < coverage {
+                    low = scale;
+                } else {
+                    high = scale;
+                }
+            }
+            for p in next.chunks_exact_mut(4) {
+                p[3] = (p[3] as f32 * high).min(255.0) as u8;
+            }
+        }
+        pixels.extend_from_slice(&next);
+        level = next;
+        (width, height) = (w, h);
+        levels += 1;
+    }
+    (pixels, levels)
+}
diff --git a/crates/assets/src/model_portraits.rs b/crates/assets/src/model_portraits.rs
new file mode 100644
index 0000000..daa52f4
--- /dev/null
+++ b/crates/assets/src/model_portraits.rs
@@ -0,0 +1,183 @@
+use bevy::prelude::*;
+
+pub fn player_portraits(
+    bodies: &asset_model::BodyMeshCatalog,
+    materials: &asset_material::MaterialDefinitions,
+) -> [Option<Image>; 2] {
+    [
+        render(bodies, materials, false),
+        render(bodies, materials, true),
+    ]
+}
+
+fn render(
+    bodies: &asset_model::BodyMeshCatalog,
+    materials: &asset_material::MaterialDefinitions,
+    axis: bool,
+) -> Option<Image> {
+    use bevy::asset::RenderAssetUsages;
+    use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+    const W: usize = 144;
+    const H: usize = 160;
+    let kit = bodies.kits().kit(axis)?;
+    let body = bodies.get(&kit.body)?;
+    let head_transform = xmodel_runtime::tp_head_attach_tag(&body.skel.bone_names)
+        .and_then(|tag| body.skel.bone_names.iter().position(|n| n == tag))
+        .and_then(|i| body.skel.bones.get(i))
+        .map(|b| b.to_mat4())
+        .unwrap_or(Mat4::IDENTITY);
+    let mut meshes = Vec::new();
+    for name in std::iter::once(&kit.body).chain(kit.head.as_ref()) {
+        let Some(entry) = bodies.get(name) else {
+            continue;
+        };
+        let transform = if name == &kit.body {
+            Mat4::IDENTITY
+        } else {
+            head_transform
+        };
+        let positions: Vec<Vec3> = entry
+            .skel
+            .positions
+            .iter()
+            .map(|p| transform.transform_point3(Vec3::from_array(*p)))
+            .collect();
+        meshes.push((entry, transform, positions));
+    }
+    let top = meshes
+        .iter()
+        .flat_map(|(_, _, p)| p.iter())
+        .map(|p| p.z)
+        .fold(f32::NEG_INFINITY, f32::max);
+    let bottom = meshes
+        .iter()
+        .flat_map(|(_, _, p)| p.iter())
+        .map(|p| p.z)
+        .fold(f32::INFINITY, f32::min);
+    if !top.is_finite() || top <= bottom {
+        return None;
+    }
+    let span = (top - bottom) * 0.51;
+    let scale = (H as f32 - 12.0) / span;
+    let toward = Vec3::new(0.95, -0.312, 0.0).normalize();
+    let right = Vec3::new(0.312, 0.95, 0.0).normalize();
+    let light = Vec3::new(0.7, -0.45, 0.65).normalize();
+    let mut rgba = vec![0u8; W * H * 4];
+    let mut depth = vec![f32::NEG_INFINITY; W * H];
+    for (entry, transform, positions) in meshes {
+        let s = &entry.skel;
+        for surface in s.surfaces_for_lod(0) {
+            let texture = entry
+                .material_keys
+                .get(surface)
+                .and_then(Option::as_ref)
+                .and_then(|key| materials.material_index_by_key(key))
+                .and_then(|i| {
+                    materials.materials[i.order()]
+                        .textures
+                        .iter()
+                        .find(|t| t.semantic == asset_material::TS_COLOR_MAP)
+                })
+                .and_then(|t| t.image)
+                .and_then(|i| materials.images[i].decoded.as_ref())
+                .and_then(|img| asset_material::decoded_image_top_level_rgba8(img).ok());
+            let (start, count) = s.surface_index_ranges[surface];
+            for tri in s.indices[start..start + count].chunks_exact(3) {
+                let ids = [tri[0] as usize, tri[1] as usize, tri[2] as usize];
+                let p = ids.map(|i| {
+                    Vec3::new(
+                        W as f32 * 0.5 + positions[i].dot(right) * scale,
+                        6.0 + (top - positions[i].z) * scale,
+                        positions[i].dot(toward),
+                    )
+                });
+                let edge = |a: Vec3, b: Vec3, x: f32, y: f32| {
+                    (b.x - a.x) * (y - a.y) - (b.y - a.y) * (x - a.x)
+                };
+                let area = edge(p[0], p[1], p[2].x, p[2].y);
+                if area.abs() < 0.001 {
+                    continue;
+                }
+                let minx = p
+                    .iter()
+                    .map(|p| p.x)
+                    .fold(f32::INFINITY, f32::min)
+                    .floor()
+                    .max(0.0) as usize;
+                let maxx = p
+                    .iter()
+                    .map(|p| p.x)
+                    .fold(f32::NEG_INFINITY, f32::max)
+                    .ceil()
+                    .clamp(0.0, (W - 1) as f32) as usize;
+                let miny = p
+                    .iter()
+                    .map(|p| p.y)
+                    .fold(f32::INFINITY, f32::min)
+                    .floor()
+                    .max(0.0) as usize;
+                let maxy = p
+                    .iter()
+                    .map(|p| p.y)
+                    .fold(f32::NEG_INFINITY, f32::max)
+                    .ceil()
+                    .clamp(0.0, (H - 1) as f32) as usize;
+                for y in miny..=maxy {
+                    for x in minx..=maxx {
+                        let a = edge(p[1], p[2], x as f32 + 0.5, y as f32 + 0.5) / area;
+                        let b = edge(p[2], p[0], x as f32 + 0.5, y as f32 + 0.5) / area;
+                        let c = 1.0 - a - b;
+                        if a < 0.0 || b < 0.0 || c < 0.0 {
+                            continue;
+                        }
+                        let z = p[0].z * a + p[1].z * b + p[2].z * c;
+                        let at = y * W + x;
+                        if z <= depth[at] {
+                            continue;
+                        }
+                        let weights = [a, b, c];
+                        let mut uv = Vec2::ZERO;
+                        let mut normal = Vec3::ZERO;
+                        for k in 0..3 {
+                            uv += Vec2::from_array(s.uvs[ids[k]]) * weights[k];
+                            normal += transform
+                                .transform_vector3(Vec3::from_array(s.normals[ids[k]]))
+                                * weights[k];
+                        }
+                        let pixel = texture
+                            .as_ref()
+                            .map(|(w, h, pixels)| {
+                                let u = ((uv.x.rem_euclid(1.0) * *w as f32) as usize)
+                                    .min(*w as usize - 1);
+                                let v = ((uv.y.rem_euclid(1.0) * *h as f32) as usize)
+                                    .min(*h as usize - 1);
+                                let t = (v * *w as usize + u) * 4;
+                                [pixels[t], pixels[t + 1], pixels[t + 2], pixels[t + 3]]
+                            })
+                            .unwrap_or([155, 160, 145, 255]);
+                        if pixel[3] < 100 {
+                            continue;
+                        }
+                        let shade = 0.52 + 0.65 * normal.normalize_or_zero().dot(light).max(0.0);
+                        for k in 0..3 {
+                            rgba[at * 4 + k] = (pixel[k] as f32 * shade).min(255.0) as u8;
+                        }
+                        rgba[at * 4 + 3] = 255;
+                        depth[at] = z;
+                    }
+                }
+            }
+        }
+    }
+    Some(Image::new(
+        Extent3d {
+            width: W as u32,
+            height: H as u32,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        rgba,
+        TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::default(),
+    ))
+}
