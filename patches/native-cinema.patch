+        .0
+        .names()
+        .find(|s| s.contains("explosion") && (s.contains("grenade") || s.contains("rpg")))
+        .or_else(|| catalog.0.names().find(|s| s.contains("explosion")))
+        .map(str::to_owned);
+    if let Some(name) = name {
+        render_fx::combat::try_play_weapon_fx_at_origin(
+            &mut host.0,
+            &catalog.0,
+            &mut infos.0,
+            Some(asset_game::FxName::engine(&name)),
+            p.to_array(),
+            render_fx::combat::IDENTITY_AXIS,
+            &mut 0,
+            None,
+        );
+    }
+}
+#[allow(clippy::too_many_arguments)]
+fn simulate(
+    mut commands: Commands,
+    time: Res<Time<Real>>,
+    take: Res<Take>,
+    mut battle: ResMut<Battle>,
+    mut world: Option<ResMut<net::AuthorityWorld>>,
+    clock: Res<net::AuthorityClock>,
+    mut pcm: ResMut<Assets<audio::PcmAudio>>,
+    mut tracers: ResMut<TracerWorld>,
+    catalog: Option<Res<PreparedTracers>>,
+    mut host: ResMut<HostFxSystem>,
+    fx_catalog: Option<Res<PreparedFxCatalog>>,
+    mut infos: ResMut<PreparedFxElemInfos>,
+    mut promotion: ResMut<hud::PendingSplash>,
+    mut native_sound: MessageWriter<audio::AliasCommand>,
+    voices: Query<Entity, With<TakeSound>>,
+    cameras: Query<&Transform, With<render_frontend::prepare::scene::camera::FlyCamera>>,
+) {
+    let Some(w) = world.as_mut() else {
+        return;
+    };
+    if take.stage < 3 {
+        return;
+    }
+    if battle.stamp != take.stamp {
+        for e in &voices {
+            commands.entity(e).despawn();
+        }
+        promotion.reset_cinematic();
+        battle.stamp = take.stamp;
+        battle.cue = 0;
+        battle.projectiles.clear();
+        battle.last_vehicle = None;
+        battle.splattered = false;
+        battle.announced = false;
+        battle.deaths = [false; 16];
+        battle.rocket_victims.clear();
+        battle.rocket_blast = None;
+        if battle.sounds.is_empty() {
+            if let Some(pack) = std::env::var_os("IW4L_CHIEF_PACK") {
+                for name in [
+                    "triple-kill",
+                    "warthog-engine",
+                    "warthog-impact",
+                    "warthog-splat",
+                    "halo-splat",
+                    "chief-death",
+                    "halo-vehicle-impact",
+                    "rocket-fire",
+                    "plasma-fire",
+                    "plasma-explosion",
+                    "plasma-fuse",
+                ] {
+                    let file = std::path::Path::new(&pack).join(format!("{name}.wav"));
+                    match std::fs::read(&file)
+                        .ok()
+                        .and_then(|bytes| audio::decode_audio_bytes(&bytes))
+                    {
+                        Some(audio) => {
+                            battle.sounds.insert(name.into(), pcm.add(audio));
+                        }
+                        None => {
+                            diag::warn!(Launch, "CINEMA SOUND failed to decode {}", file.display())
+                        }
+                    }
+                }
+            }
+        }
+        diag::info!(
+            Launch,
+            "CINEMA BATTLEFIELD: native props, projectiles and {} local sounds",
+            battle.sounds.len()
+        );
+    }
+    if let Ok(camera) = cameras.single() {
+        battle.ear = camera.translation;
+        battle.right = camera.rotation * Vec3::X;
+    }
+    let t = take.t;
+    let dt = time.delta_secs().clamp(0., 0.06);
+    let events = take.json["battle"].as_array();
+    if let Some(events) = events {
+        while battle.cue < events.len() && n(&events[battle.cue], "at", 0.) <= t {
+            let e = &events[battle.cue];
+            battle.cue += 1;
+            let kind = e["kind"].as_str().unwrap_or("");
+            let actor = e["actor"].as_u64().unwrap_or(8) as u32;
+            let ps = w.0.player(sim::ClientId(actor));
+            let mut start = ps
+                .map(|p| {
+                    Vec3::from_array(p.origin) + Vec3::Z * if kind == "grenade" { 60. } else { 46. }
+                })
+                .unwrap_or(Vec3::ZERO);
+            if let Some(p) = vec(&e["origin"]) {
+                start = p;
+            }
+            let mut target = vec(&e["point"])
+                .or_else(|| {
+                    e["target"].as_u64().and_then(|id| {
+                        w.0.player(sim::ClientId(id as u32))
+                            .map(|p| Vec3::from_array(p.origin) + Vec3::Z * 44.)
+                    })
+                })
+                .unwrap_or(start + Vec3::X * 600.);
+            target += vec(&e["offset"]).unwrap_or(Vec3::ZERO);
+            if ["plasma", "grenade", "rocket"].contains(&kind) && ps.is_some_and(|p| p.health > 0) {
+                let flight = n(
+                    e,
+                    "flight",
+                    if kind == "grenade" {
+                        0.85
+                    } else {
+                        (target - start).length() / 1150.
+                    },
+                );
+                let mut v = (target - start) / flight.max(0.1);
+                if kind == "grenade" {
+                    v.z += 400. * flight;
+                }
+                start += v.normalize_or_zero() * 18.;
+                battle.projectiles.push(Projectile {
+                    kind: kind.into(),
+                    actor,
+                    p: start,
+                    v,
+                    born: t,
+                    fuse: n(e, "fuse", if kind == "grenade" { 1.8 } else { 3. }),
+                    alive: true,
+                });
+                sound(
+                    &mut commands,
+                    &mut pcm,
+                    &battle,
+                    if kind == "plasma" {
+                        "plasma-fire"
+                    } else if kind == "rocket" {
+                        "rocket-fire"
+                    } else {
+                        "plasma-fuse"
+                    },
+                    if kind == "grenade" {
+                        0.3
+                    } else if kind == "rocket" {
+                        0.75
+                    } else {
+                        0.12
+                    },
+                    Some(start),
+                );
+                diag::info!(
+                    Launch,
+                    "CINEMA PROJECTILE t={t:0.2} kind={kind} actor={actor} from={:?} to={:?}",
+                    start,
+                    target
+                );
+            } else if kind == "native_rocket" {
+                // Native RPG attack owns animation, missile collision and damage.
+                // This cue adds CE audio and bounds the announcer's kill window.
+                battle.rocket_blast = Some((t + n(e, "flight", 0.55), target));
+                sound(
+                    &mut commands,
+                    &mut pcm,
+                    &battle,
+                    "rocket-fire",
+                    0.9,
+                    Some(start),
+                );
+                diag::info!(
+                    Launch,
+                    "CINEMA NATIVE ROCKET t={t:.3} actor={actor} target={target:?}"
+                );
+            } else if kind == "near_miss" {
+                if let Some(c) = catalog.as_ref() {
+                    beam(
+                        &mut tracers,
+                        c,
+                        &host,
+                        start,
+                        target,
+                        [1., 0.86, 0.5, 1.],
+                        9000.,
+                        1.7,
+                        95.,
+                    );
+                }
+                sound(
+                    &mut commands,
+                    &mut pcm,
+                    &battle,
+                    "rocket-fire",
+                    0.12,
+                    Some(start),
+                );
+            } else if kind == "engine" {
+                sound(
+                    &mut commands,
+                    &mut pcm,
+                    &battle,
+                    "warthog-engine",
+                    n(e, "volume", 0.65),
+                    None,
+                );
+            }
+        }
+    }
+    if let Some(vehicle) = take.json.get("vehicle") {
+        let p = path(&vehicle["route"], t);
+        let previous = battle.last_vehicle.unwrap_or(p);
+        if t >= n(vehicle, "start", 5.) && !battle.splattered {
+            if let Some(ps) = w.0.player(sim::ClientId(0)) {
+                let q = Vec3::from_array(ps.origin) + Vec3::Z * 25.;
+                let d = p - previous;
+                let u = ((q - previous).dot(d) / d.length_squared().max(0.01)).clamp(0., 1.);
+                let closest = previous + d * u;
+                if (q - closest).truncate().length() < n(vehicle, "radius", 90.)
+                    && (q.z - closest.z).abs() < 85.
+                {
+                    if w.0.cinema_contact_damage(
+                        sim::Tick(clock.tick),
+                        sim::ClientId(15),
+                        sim::ClientId(0),
+                        p.to_array(),
+                        500,
+                    ) {
+                        battle.splattered = true;
+                        promotion.cinematic("promotion", 2);
+                        native_sound.write(audio::AliasCommand::Play(audio::PlayAlias {
+                            namespace: asset_core::AssetNamespace::Iw4,
+                            alias: "mp_level_up".into(),
+                            fallback: None,
+                            origin_inches: None,
+                            snd_ent: Some(audio::SND_ENT_LOCAL),
+                        }));
+                        diag::info!(Launch, "CINEMA PROMOTION impact t={t:.3} sound=mp_level_up");
+                        sound(&mut commands, &mut pcm, &battle, "halo-splat", 1.6, None);
+                        sound(&mut commands, &mut pcm, &battle, "chief-death", 1.2, None);
+                        sound(&mut commands, &mut pcm, &battle, "warthog-splat", 1.8, None);
+                        sound(
+                            &mut commands,
+                            &mut pcm,
+                            &battle,
+                            "warthog-impact",
+                            1.,
+                            Some(p),
+                        );
+                        diag::info!(Launch, "CINEMA SPLATTER t={t:0.3} vehicle={p:?}");
+                    }
+                }
+            }
+        }
+        battle.last_vehicle = Some(p);
+    }
+    let mut explosions = Vec::new();
+    for shot in &mut battle.projectiles {
+        if !shot.alive {
+            continue;
+        }
+        let next = shot.p + shot.v * dt;
+        let hit = w.0.bullet_trace(
+            sim::BulletTraceQuery {
+                start: shot.p.to_array(),
+                end: next.to_array(),
+                mask: sim::MASK_SHOT,
+                ignore: Some(sim::ClientId(shot.actor)),
+                ignore_hit: None,
+                ignore_model: None,
+            },
+            None,
+        );
+        let mut impact = false;
+        match hit {
+            sim::TraceOutcome::Hit { end, collider, .. } => {
+                shot.p = Vec3::from_array(end);
+                impact = true;
+                if shot.kind == "plasma" {
+                    if let sim::ColliderId::Player { client, .. } = collider {
+                        w.0.cinema_contact_damage(
+                            sim::Tick(clock.tick),
+                            sim::ClientId(shot.actor),
+                            client,
+                            end,
+                            18,
+                        );
+                    }
+                }
+                if shot.kind == "grenade" {
+                    shot.v = Vec3::ZERO;
+                }
+            }
+            sim::TraceOutcome::StartSolid { .. } => {
+                impact = true;
+                shot.v = Vec3::ZERO;
+            }
+            _ => shot.p = next,
+        }
+        if shot.kind == "grenade" && shot.v.length_squared() > 0. {
+            shot.v.z -= 800. * dt;
+        }
+        if let Some(c) = catalog.as_ref() {
+            let color = if shot.kind == "plasma" {
+                [0.15, 1., 0.18, 1.]
+            } else if shot.kind == "grenade" {
+                [0.15, 0.42, 1., 1.]
+            } else {
+                [1., 0.65, 0.12, 1.]
+            };
+            let end = shot.p
+                + if shot.v.length() > 1. {
+                    shot.v.normalize_or_zero() * 140.
+                } else {
+                    Vec3::Z * 30.
+                };
+            beam(
+                &mut tracers,
+                c,
+                &host,
+                shot.p,
+                end,
+                color,
+                1200.,
+                if shot.kind == "grenade" { 7. } else { 6. },
+                25.,
+            );
+        }
+        if t - shot.born > shot.fuse || (impact && shot.kind != "grenade") {
+            shot.alive = false;
+            if shot.kind != "plasma" {
+                explosions.push((shot.actor, shot.p, shot.kind.clone()));
+            }
+        }
+    }
+    for (actor, p, kind) in explosions {
+        w.0.cinema_blast(
+            sim::Tick(clock.tick),
+            sim::ClientId(actor),
+            p.to_array(),
+            if kind == "rocket" { 220. } else { 165. },
+            150.,
+        );
+        if let Some(c) = fx_catalog.as_ref() {
+            burst(&mut host, c, &mut infos, p);
+        }
+        sound(
+            &mut commands,
+            &mut pcm,
+            &battle,
+            "plasma-explosion",
+            0.8,
+            Some(p),
+        );
+        if kind == "rocket" && actor == 13 {
+            battle.rocket_blast = Some((t, p));
+        }
+        if let Some(c) = catalog.as_ref() {
+            for i in 0..18 {
+                let a = i as f32 * 2.399;
+                let d = Vec3::new(a.cos(), a.sin(), 0.25 + (i % 4) as f32 * 0.2);
+                beam(
+                    &mut tracers,
+                    c,
+                    &host,
+                    p,
+                    p + d * 130.,
+                    if kind == "grenade" {
+                        [0.18, 0.45, 1., 1.]
+                    } else {
+                        [1., 0.5, 0.08, 1.]
+                    },
+                    380.,
+                    3.,
+                    25.,
+                );
+            }
+        }
+        diag::info!(
+            Launch,
+            "CINEMA EXPLOSION t={t:0.3} actor={actor} kind={kind} origin={p:?}"
+        );
+    }
+    for id in 3..8 {
+        if let Some(ps) = w.0.player(sim::ClientId(id)) {
+            if ps.health <= 0 && !battle.deaths[id as usize] {
+                battle.deaths[id as usize] = true;
+                if battle.rocket_blast.is_some_and(|(at, origin)| {
+                    (t - at).abs() < 0.75 && origin.distance(Vec3::from_array(ps.origin)) < 260.
+                }) {
+                    battle.rocket_victims.push((id, t));
+                }
+            }
+        }
+    }
+    if !battle.announced
+        && battle
+            .rocket_victims
+            .iter()
+            .filter(|(_, at)| t - *at < 1.5)
+            .count()
+            >= 3
+    {
+        battle.announced = true;
+        sound(&mut commands, &mut pcm, &battle, "triple-kill", 1.25, None);
+        diag::info!(
+            Launch,
+            "CINEMA TRIPLE KILL t={t:0.3} victims={:?}",
+            battle.rocket_victims
+        );
+    }
+}
+fn props(
+    mut commands: Commands,
+    take: Res<Take>,
+    battle: Res<Battle>,
+    mut existing: Query<(
+        &Prop,
+        &mut WorldScriptModelInstance,
+        &mut Transform,
+        &mut Visibility,
+    )>,
+    catalog: Option<Res<asset_world::MapXModelSceneCatalog>>,
+) {
+    let Some(catalog) = catalog else {
+        return;
+    };
+    if take.stage < 2 {
+        return;
+    }
+    if existing.is_empty() {
+        for (slot, kind) in std::iter::once((0, "warthog"))
+            .chain((0..20).map(|i| (i, "plasma_grenade")))
+            .chain((0..6).map(|i| (i, "rocket_projectile")))
+        {
+            let name = format!("halo_ce_{kind}");
+            if catalog.get_name(&name).is_none() {
+                continue;
+            }
+            let transform = Transform::from_translation(Vec3::new(0., 0., -10000.));
+            commands.spawn((
+                Prop {
+                    kind: kind.into(),
+                    slot,
+                },
+                transform,
+                Visibility::Hidden,
+                WorldScriptModelInstance {
+                    id: asset_world::ScriptModelId::from_source_ordinal(
+                        0x20000000
+                            + slot as u32
+                            + if kind == "warthog" {
+                                0
+                            } else if kind == "plasma_grenade" {
+                                100
+                            } else {
+                                200
+                            },
+                    ),
+                    authority_owner: None,
+                    current_model: asset_world::MapXModelAssetKey(name.clone()),
+                    transform,
+                    lighting_origin: [0.; 3],
+                    dobj_state: xmodel_runtime::DObjSemanticState::bind_pose(name, 1, 1),
+                    metadata: asset_world::ScriptModelMetadata {
+                        gameobject: "local_cinema_prop".into(),
+                        ..default()
+                    },
+                    gentity_number: None,
+                },
+            ));
+        }
+    }
+    for (prop, mut owner, mut xf, mut visible) in &mut existing {
+        *visible = Visibility::Hidden;
+        if prop.kind == "warthog" {
+            if let Some(v) = take.json.get("vehicle") {
+                let p = path(&v["route"], take.t);
+                let facing_t = take.t.min(n(v, "stop", 8.) - 0.04);
+                let d = path(&v["route"], facing_t + 0.02)
+                    - path(&v["route"], (facing_t - 0.02).max(0.));
+                let yaw = if d.truncate().length() > 0.01 {
+                    d.y.atan2(d.x)
+                } else {
+                    -std::f32::consts::FRAC_PI_2
+                };
+                let pitch = (-d.z).atan2(d.truncate().length().max(0.1));
+                *xf = Transform::from_translation(p).with_rotation(Quat::from_euler(
+                    EulerRot::ZYX,
+                    yaw,
+                    pitch,
+                    0.,
+                ));
+                if take.t >= n(v, "draw_start", 0.) {
+                    *visible = Visibility::Inherited;
+                }
+            }
+        } else {
+            let kind = if prop.kind == "plasma_grenade" {
+                "grenade"
+            } else {
+                "rocket"
+            };
+            if let Some(s) = battle
+                .projectiles
+                .iter()
+                .filter(|s| s.kind == kind && s.alive)
+                .nth(prop.slot)
+            {
+                *xf = Transform::from_translation(s.p)
+                    .with_rotation(Quat::from_rotation_z(take.t * 7.))
+                    .with_scale(Vec3::splat(if kind == "grenade" { 1.7 } else { 1. }));
+                *visible = Visibility::Inherited;
+            }
+        }
+        owner.transform = *xf;
+        owner.lighting_origin = xf.translation.to_array();
+    }
+}
