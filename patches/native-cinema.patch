+use serde_json::Value;
+
+#[derive(Default)]
+struct AimMotion {
+    angles: [f32; 3],
+    velocity: [f32; 2],
+    initialized: bool,
+}
+#[derive(Resource, Default)]
+struct Controllers(std::collections::BTreeMap<u32, AimMotion>);
+struct Actor {
+    id: u32,
+    name: String,
+    weapon: String,
+    route: Vec<[f32; 4]>,
+    aim: Vec<Value>,
+    buttons: Vec<[f32; 3]>,
+    yaw: f32,
+}
+#[derive(Resource)]
+pub(super) struct Take {
+    pub(super) json: Value,
+    actors: Vec<Actor>,
+    pub(super) stage: u8,
+    pub(super) stamp: f32,
+    pub(super) t: f32,
+    last_log: i32,
+    cue: usize,
+    death: Option<f32>,
+    seen: [bool; 16],
+    modified: Option<std::time::SystemTime>,
+}
+fn parse(v: Value) -> Take {
+    assert_eq!(v["version"], 2);
+    let actors = v["actors"]
+        .as_array()
+        .expect("actors")
+        .iter()
+        .map(|a| Actor {
+            id: a["id"].as_u64().expect("id") as u32,
+            name: a["name"].as_str().unwrap().into(),
+            weapon: a["weapon"].as_str().unwrap().into(),
+            route: serde_json::from_value(a["route"].clone()).expect("route"),
+            aim: a["aim"].as_array().unwrap().clone(),
+            buttons: serde_json::from_value(a["buttons"].clone()).expect("buttons"),
+            yaw: n(a, "yaw", 90.),
+        })
+        .collect::<Vec<_>>();
+    assert!(actors.iter().all(|a| a.id < 16
+        && !a.route.is_empty()
+        && a.route.iter().flatten().all(|x| x.is_finite())));
+    Take {
+        json: v,
+        actors,
+        stage: 0,
+        stamp: 0.,
+        t: 0.,
+        last_log: -1,
+        cue: 0,
+        death: None,
+        seen: [false; 16],
+        modified: modified(),
+    }
+}
+pub(super) fn n(v: &Value, k: &str, default: f32) -> f32 {
+    v[k].as_f64().map(|x| x as f32).unwrap_or(default)
+}
+fn modified() -> Option<std::time::SystemTime> {
+    std::fs::metadata(std::env::var_os("IW4L_CINEMA")?)
+        .ok()?
+        .modified()
+        .ok()
+}
+pub(crate) fn install(app: &mut App, v: Value) {
+    app.insert_resource(parse(v));
+    super::cinema_battlefield::install(app);
+    app.init_resource::<Controllers>();
+    app.add_systems(Update, drive.in_set(ClientSet::Input).before(control));
+    app.add_systems(
+        Update,
+        control
+            .in_set(ClientSet::Input)
+            .after(net::client::runtime::sample_client_input),
+    );
+    app.add_systems(
+        Update,
+        camera
+            .in_set(ClientSet::Present)
+            .before(RenderSet::FrontendPrepare),
+    );
+    app.add_systems(
+        Update,
+        hide_gun
+            .in_set(ClientSet::Present)
+            .after(FpvGeometrySet)
+            .after(FpvPlacementSet)
+            .after(frame::WorkerCmdSet::AddSceneEnt)
+            .in_set(render_frontend::assemble::ViewmodelDrawReady),
+    );
+}
+pub(super) fn drive(
