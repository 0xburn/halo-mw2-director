+fn vec(v: &serde_json::Value) -> Option<Vec3> {
+    serde_json::from_value::<[f32; 3]>(v.clone())
+        .ok()
+        .map(Vec3::from_array)
+}
+// Monotone cubic route: continuous velocity through turns, no sideways snaps.
+fn path(rows: &serde_json::Value, t: f32) -> Vec3 {
+    let Some(rows) = rows.as_array() else {
+        return Vec3::ZERO;
+    };
+    if rows.is_empty() {
+        return Vec3::ZERO;
+    }
+    let point = |i: usize| {
+        Vec3::new(
+            rows[i][1].as_f64().unwrap() as f32,
+            rows[i][2].as_f64().unwrap() as f32,
+            rows[i][3].as_f64().unwrap() as f32,
+        )
+    };
+    let at = |i: usize| rows[i][0].as_f64().unwrap() as f32;
+    let slope = |i: usize, j: usize| (point(j) - point(i)) / (at(j) - at(i)).max(0.001);
+    let tangent = |i: usize| {
+        if i == 0 {
+            return slope(0, 1.min(rows.len() - 1));
+        }
+        if i + 1 == rows.len() {
+            return Vec3::ZERO;
+        }
+        let a = slope(i - 1, i);
+        let b = slope(i, i + 1);
+        Vec3::from_array(std::array::from_fn(|k| {
+            if a[k] * b[k] <= 0. {
+                0.
+            } else {
+                2. * a[k] * b[k] / (a[k] + b[k])
+            }
+        }))
+    };
+    for i in 0..rows.len() - 1 {
+        if t < at(i + 1) {
+            let h = at(i + 1) - at(i);
+            let u = ((t - at(i)) / h).clamp(0., 1.);
+            return point(i) * (2. * u * u * u - 3. * u * u + 1.)
+                + tangent(i) * h * (u * u * u - 2. * u * u + u)
+                + point(i + 1) * (-2. * u * u * u + 3. * u * u)
+                + tangent(i + 1) * h * (u * u * u - u * u);
+        }
+    }
+    point(rows.len() - 1)
+}
+
+fn sound(
+    commands: &mut Commands,
+    pcm: &mut Assets<audio::PcmAudio>,
+    battle: &Battle,
+    name: &str,
+    volume: f32,
+    origin: Option<Vec3>,
+) {
+    if let Some(handle) = battle.sounds.get(name) {
+        if [
+            "warthog-engine",
+            "warthog-splat",
+            "halo-splat",
+            "chief-death",
+            "triple-kill",
+        ]
+        .contains(&name)
+        {
+            diag::info!(Launch, "CINEMA SOUND play {name} volume={volume}");
+        }
+        let handle = if let Some(origin) = origin {
+            let Some(source) = pcm.get(handle) else {
+                return;
+            };
+            let clip = source.with_live_pan();
+            let d = origin - battle.ear;
+            let pan = d.normalize_or_zero().dot(battle.right).clamp(-0.9, 0.9);
+            let gain = (700. / (700. + d.length())).powf(0.6);
+            if let Some(live) = clip.live_pan() {
+                live.set((1. - pan).sqrt() * gain, (1. + pan).sqrt() * gain);
+            }
+            pcm.add(clip)
+        } else {
+            handle.clone()
+        };
+        commands.spawn((
+            TakeSound,
+            AudioPlayer(handle),
+            PlaybackSettings::DESPAWN.with_volume(Volume::Linear(volume)),
+        ));
+    }
+}
+
+fn beam(
+    tracers: &mut TracerWorld,
+    catalog: &PreparedTracers,
+    host: &HostFxSystem,
+    start: Vec3,
+    end: Vec3,
+    color: [f32; 4],
+    speed: f32,
+    width: f32,
+    length: f32,
+) {
+    let Some(material) = catalog
+        .0
+        .defs()
+        .find(|d| d.name == "pistol")
+        .and_then(|d| d.material.bound_index())
+    else {
+        return;
+    };
+    let d = end - start;
+    let dist = d.length();
+    if dist < 1. {
+        return;
+    }
+    tracers.pool.alloc(fx::LocalEntitySlot {
+        le_type: fx::LE_MOVING_TRACER,
+        pos_tr_time: host.0.msec_now,
+        pos_tr_type: fx::LE_TR_LINEAR,
+        pos_tr_duration: 0,
+        pos_tr_delta: (d / dist * speed).to_array(),
+        pos_tr_base: start.to_array(),
+        end_time: host.0.msec_now + ((dist / speed * 1000.) as i32).max(90),
+        material: Some(material),
+        tracer_clip_dist: dist,
+        beam_length: length,
+        beam_width: width,
+        screw_dist: 0.,
+        screw_radius: 0.,
+        colors: [color; 5],
+        own_shot: false,
+    });
+}
+fn burst(
+    host: &mut HostFxSystem,
+    catalog: &PreparedFxCatalog,
+    infos: &mut PreparedFxElemInfos,
+    p: Vec3,
+) {
+    let name = catalog
+        .0
+        .names()
+        .find(|s| s.contains("explosion") && (s.contains("grenade") || s.contains("rpg")))
+        .or_else(|| catalog.0.names().find(|s| s.contains("explosion")))
+        .map(str::to_owned);
+    if let Some(name) = name {
+        render_fx::combat::try_play_weapon_fx_at_origin(
+            &mut host.0,
+            &catalog.0,
+            &mut infos.0,
+            Some(asset_game::FxName::engine(&name)),
+            p.to_array(),
+            render_fx::combat::IDENTITY_AXIS,
+            &mut 0,
+            None,
+        );
+    }
+}
+#[allow(clippy::too_many_arguments)]
+fn simulate(
+    mut commands: Commands,
+    time: Res<Time<Real>>,
+    take: Res<Take>,
+    mut battle: ResMut<Battle>,
+    mut world: Option<ResMut<net::AuthorityWorld>>,
+    clock: Res<net::AuthorityClock>,
+    mut pcm: ResMut<Assets<audio::PcmAudio>>,
+    mut tracers: ResMut<TracerWorld>,
+    catalog: Option<Res<PreparedTracers>>,
+    mut host: ResMut<HostFxSystem>,
+    fx_catalog: Option<Res<PreparedFxCatalog>>,
+    mut infos: ResMut<PreparedFxElemInfos>,
+    mut promotion: ResMut<hud::PendingSplash>,
+    mut native_sound: MessageWriter<audio::AliasCommand>,
+    voices: Query<Entity, With<TakeSound>>,
+    cameras: Query<&Transform, With<render_frontend::prepare::scene::camera::FlyCamera>>,
+) {
+    let Some(w) = world.as_mut() else {
+        return;
+    };
+    if take.stage < 3 {
+        return;
+    }
+    if battle.stamp != take.stamp {
+        for e in &voices {
+            commands.entity(e).despawn();
+        }
+        promotion.reset_cinematic();
+        battle.stamp = take.stamp;
+        battle.cue = 0;
+        battle.projectiles.clear();
+        battle.last_vehicle = None;
+        battle.splattered = false;
+        battle.announced = false;
+        battle.deaths = [false; 16];
+        battle.rocket_victims.clear();
+        battle.rocket_blast = None;
+        if battle.sounds.is_empty() {
+            if let Some(pack) = std::env::var_os("IW4L_CHIEF_PACK") {
+                for name in [
+                    "triple-kill",
+                    "warthog-engine",
+                    "warthog-impact",
+                    "warthog-splat",
+                    "halo-splat",
+                    "chief-death",
+                    "halo-vehicle-impact",
+                    "rocket-fire",
+                    "plasma-fire",
+                    "plasma-explosion",
+                    "plasma-fuse",
+                ] {
+                    let file = std::path::Path::new(&pack).join(format!("{name}.wav"));
+                    match std::fs::read(&file)
+                        .ok()
+                        .and_then(|bytes| audio::decode_audio_bytes(&bytes))
+                    {
+                        Some(audio) => {
+                            battle.sounds.insert(name.into(), pcm.add(audio));
+                        }
+                        None => {
+                            diag::warn!(Launch, "CINEMA SOUND failed to decode {}", file.display())
+                        }
+                    }
+                }
+            }
+        }
+        diag::info!(
+            Launch,
+            "CINEMA BATTLEFIELD: native props, projectiles and {} local sounds",
+            battle.sounds.len()
+        );
+    }
+    if let Ok(camera) = cameras.single() {
+        battle.ear = camera.translation;
+        battle.right = camera.rotation * Vec3::X;
+    }
+    let t = take.t;
+    let dt = time.delta_secs().clamp(0., 0.06);
+    let events = take.json["battle"].as_array();
+    if let Some(events) = events {
+        while battle.cue < events.len() && n(&events[battle.cue], "at", 0.) <= t {
+            let e = &events[battle.cue];
+            battle.cue += 1;
+            let kind = e["kind"].as_str().unwrap_or("");
+            let actor = e["actor"].as_u64().unwrap_or(8) as u32;
+            let ps = w.0.player(sim::ClientId(actor));
+            let mut start = ps
+                .map(|p| {
+                    Vec3::from_array(p.origin) + Vec3::Z * if kind == "grenade" { 60. } else { 46. }
+                })
+                .unwrap_or(Vec3::ZERO);
+            if let Some(p) = vec(&e["origin"]) {
+                start = p;
+            }
+            let mut target = vec(&e["point"])
+                .or_else(|| {
+                    e["target"].as_u64().and_then(|id| {
+                        w.0.player(sim::ClientId(id as u32))
+                            .map(|p| Vec3::from_array(p.origin) + Vec3::Z * 44.)
+                    })
+                })
+                .unwrap_or(start + Vec3::X * 600.);
+            target += vec(&e["offset"]).unwrap_or(Vec3::ZERO);
+            if ["plasma", "grenade", "rocket"].contains(&kind) && ps.is_some_and(|p| p.health > 0) {
+                let flight = n(
+                    e,
+                    "flight",
+                    if kind == "grenade" {
+                        0.85
+                    } else {
+                        (target - start).length() / 1150.
+                    },
+                );
+                let mut v = (target - start) / flight.max(0.1);
+                if kind == "grenade" {
+                    v.z += 400. * flight;
+                }
+                start += v.normalize_or_zero() * 18.;
+                battle.projectiles.push(Projectile {
+                    kind: kind.into(),
+                    actor,
+                    p: start,
+                    v,
+                    born: t,
+                    fuse: n(e, "fuse", if kind == "grenade" { 1.8 } else { 3. }),
+                    alive: true,
+                });
+                sound(
+                    &mut commands,
+                    &mut pcm,
+                    &battle,
+                    if kind == "plasma" {
+                        "plasma-fire"
+                    } else if kind == "rocket" {
+                        "rocket-fire"
+                    } else {
+                        "plasma-fuse"
+                    },
+                    if kind == "grenade" {
+                        0.3
+                    } else if kind == "rocket" {
+                        0.75
+                    } else {
+                        0.12
+                    },
+                    Some(start),
+                );
+                diag::info!(
+                    Launch,
+                    "CINEMA PROJECTILE t={t:0.2} kind={kind} actor={actor} from={:?} to={:?}",
+                    start,
+                    target
+                );
+            } else if kind == "native_rocket" {
+                // Native RPG attack owns animation, missile collision and damage.
+                // This cue adds CE audio and bounds the announcer's kill window.
+                battle.rocket_blast = Some((t + n(e, "flight", 0.55), target));
+                sound(
+                    &mut commands,
+                    &mut pcm,
+                    &battle,
+                    "rocket-fire",
+                    0.9,
+                    Some(start),
+                );
+                diag::info!(
+                    Launch,
+                    "CINEMA NATIVE ROCKET t={t:.3} actor={actor} target={target:?}"
+                );
+            } else if kind == "near_miss" {
+                if let Some(c) = catalog.as_ref() {
+                    beam(
+                        &mut tracers,
+                        c,
+                        &host,
+                        start,
+                        target,
+                        [1., 0.86, 0.5, 1.],
+                        9000.,
+                        1.7,
+                        95.,
+                    );
+                }
+                sound(
+                    &mut commands,
+                    &mut pcm,
+                    &battle,
+                    "rocket-fire",
+                    0.12,
+                    Some(start),
+                );
+            } else if kind == "engine" {
+                sound(
+                    &mut commands,
+                    &mut pcm,
+                    &battle,
+                    "warthog-engine",
+                    n(e, "volume", 0.65),
+                    None,
+                );
+            }
+        }
+    }
+    if let Some(vehicle) = take.json.get("vehicle") {
+        let p = path(&vehicle["route"], t);
+        let previous = battle.last_vehicle.unwrap_or(p);
+        if t >= n(vehicle, "start", 5.) && !battle.splattered {
+            if let Some(ps) = w.0.player(sim::ClientId(0)) {
+                let q = Vec3::from_array(ps.origin) + Vec3::Z * 25.;
+                let d = p - previous;
+                let u = ((q - previous).dot(d) / d.length_squared().max(0.01)).clamp(0., 1.);
+                let closest = previous + d * u;
+                if (q - closest).truncate().length() < n(vehicle, "radius", 90.)
+                    && (q.z - closest.z).abs() < 85.
+                {
+                    if w.0.cinema_contact_damage(
+                        sim::Tick(clock.tick),
+                        sim::ClientId(15),
+                        sim::ClientId(0),
+                        p.to_array(),
+                        500,
+                    ) {
+                        battle.splattered = true;
+                        promotion.cinematic("promotion", 2);
+                        native_sound.write(audio::AliasCommand::Play(audio::PlayAlias {
+                            namespace: asset_core::AssetNamespace::Iw4,
+                            alias: "mp_level_up".into(),
+                            fallback: None,
+                            origin_inches: None,
+                            snd_ent: Some(audio::SND_ENT_LOCAL),
+                        }));
+                        diag::info!(Launch, "CINEMA PROMOTION impact t={t:.3} sound=mp_level_up");
+                        sound(&mut commands, &mut pcm, &battle, "halo-splat", 1.6, None);
+                        sound(&mut commands, &mut pcm, &battle, "chief-death", 1.2, None);
+                        sound(&mut commands, &mut pcm, &battle, "warthog-splat", 1.8, None);
+                        sound(
+                            &mut commands,
+                            &mut pcm,
+                            &battle,
+                            "warthog-impact",
+                            1.,
+                            Some(p),
+                        );
+                        diag::info!(Launch, "CINEMA SPLATTER t={t:0.3} vehicle={p:?}");
+                    }
+                }
+            }
+        }
+        battle.last_vehicle = Some(p);
+    }
+    let mut explosions = Vec::new();
+    for shot in &mut battle.projectiles {
+        if !shot.alive {
+            continue;
+        }
+        let next = shot.p + shot.v * dt;
+        let hit = w.0.bullet_trace(
+            sim::BulletTraceQuery {
+                start: shot.p.to_array(),
+                end: next.to_array(),
+                mask: sim::MASK_SHOT,
+                ignore: Some(sim::ClientId(shot.actor)),
+                ignore_hit: None,
+                ignore_model: None,
+            },
+            None,
+        );
+        let mut impact = false;
+        match hit {
+            sim::TraceOutcome::Hit { end, collider, .. } => {
+                shot.p = Vec3::from_array(end);
+                impact = true;
+                if shot.kind == "plasma" {
+                    if let sim::ColliderId::Player { client, .. } = collider {
+                        w.0.cinema_contact_damage(
+                            sim::Tick(clock.tick),
+                            sim::ClientId(shot.actor),
+                            client,
+                            end,
+                            18,
+                        );
+                    }
+                }
+                if shot.kind == "grenade" {
+                    shot.v = Vec3::ZERO;
+                }
+            }
+            sim::TraceOutcome::StartSolid { .. } => {
+                impact = true;
+                shot.v = Vec3::ZERO;
+            }
+            _ => shot.p = next,
+        }
+        if shot.kind == "grenade" && shot.v.length_squared() > 0. {
+            shot.v.z -= 800. * dt;
+        }
+        if let Some(c) = catalog.as_ref() {
+            let color = if shot.kind == "plasma" {
+                [0.15, 1., 0.18, 1.]
+            } else if shot.kind == "grenade" {
+                [0.15, 0.42, 1., 1.]
+            } else {
+                [1., 0.65, 0.12, 1.]
+            };
+            let end = shot.p
+                + if shot.v.length() > 1. {
+                    shot.v.normalize_or_zero() * 140.
+                } else {
+                    Vec3::Z * 30.
+                };
+            beam(
+                &mut tracers,
+                c,
+                &host,
+                shot.p,
+                end,
+                color,
+                1200.,
+                if shot.kind == "grenade" { 7. } else { 6. },
+                25.,
+            );
+        }
+        if t - shot.born > shot.fuse || (impact && shot.kind != "grenade") {
+            shot.alive = false;
+            if shot.kind != "plasma" {
+                explosions.push((shot.actor, shot.p, shot.kind.clone()));
+            }
+        }
+    }
+    for (actor, p, kind) in explosions {
+        w.0.cinema_blast(
+            sim::Tick(clock.tick),
+            sim::ClientId(actor),
+            p.to_array(),
+            if kind == "rocket" { 220. } else { 165. },
+            150.,
+        );
+        if let Some(c) = fx_catalog.as_ref() {
+            burst(&mut host, c, &mut infos, p);
+        }
+        sound(
+            &mut commands,
+            &mut pcm,
+            &battle,
+            "plasma-explosion",
+            0.8,
+            Some(p),
+        );
+        if kind == "rocket" && actor == 13 {
+            battle.rocket_blast = Some((t, p));
+        }
+        if let Some(c) = catalog.as_ref() {
+            for i in 0..18 {
+                let a = i as f32 * 2.399;
+                let d = Vec3::new(a.cos(), a.sin(), 0.25 + (i % 4) as f32 * 0.2);
+                beam(
+                    &mut tracers,
+                    c,
+                    &host,
+                    p,
+                    p + d * 130.,
+                    if kind == "grenade" {
+                        [0.18, 0.45, 1., 1.]
+                    } else {
+                        [1., 0.5, 0.08, 1.]
+                    },
+                    380.,
+                    3.,
+                    25.,
+                );
+            }
+        }
+        diag::info!(
+            Launch,
+            "CINEMA EXPLOSION t={t:0.3} actor={actor} kind={kind} origin={p:?}"
+        );
+    }
+    for id in 3..8 {
+        if let Some(ps) = w.0.player(sim::ClientId(id)) {
+            if ps.health <= 0 && !battle.deaths[id as usize] {
+                battle.deaths[id as usize] = true;
+                if battle.rocket_blast.is_some_and(|(at, origin)| {
+                    (t - at).abs() < 0.75 && origin.distance(Vec3::from_array(ps.origin)) < 260.
+                }) {
+                    battle.rocket_victims.push((id, t));
+                }
+            }
+        }
+    }
+    if !battle.announced
+        && battle
+            .rocket_victims
+            .iter()
+            .filter(|(_, at)| t - *at < 1.5)
+            .count()
+            >= 3
+    {
+        battle.announced = true;
+        sound(&mut commands, &mut pcm, &battle, "triple-kill", 1.25, None);
+        diag::info!(
+            Launch,
+            "CINEMA TRIPLE KILL t={t:0.3} victims={:?}",
+            battle.rocket_victims
+        );
+    }
+}
+fn props(
+    mut commands: Commands,
+    take: Res<Take>,
+    battle: Res<Battle>,
+    mut existing: Query<(
+        &Prop,
+        &mut WorldScriptModelInstance,
+        &mut Transform,
+        &mut Visibility,
+    )>,
+    catalog: Option<Res<asset_world::MapXModelSceneCatalog>>,
+) {
+    let Some(catalog) = catalog else {
+        return;
+    };
+    if take.stage < 2 {
+        return;
+    }
+    if existing.is_empty() {
+        for (slot, kind) in std::iter::once((0, "warthog"))
+            .chain((0..20).map(|i| (i, "plasma_grenade")))
+            .chain((0..6).map(|i| (i, "rocket_projectile")))
+        {
+            let name = format!("halo_ce_{kind}");
+            if catalog.get_name(&name).is_none() {
+                continue;
+            }
+            let transform = Transform::from_translation(Vec3::new(0., 0., -10000.));
+            commands.spawn((
+                Prop {
+                    kind: kind.into(),
+                    slot,
+                },
+                transform,
+                Visibility::Hidden,
+                WorldScriptModelInstance {
+                    id: asset_world::ScriptModelId::from_source_ordinal(
+                        0x20000000
+                            + slot as u32
+                            + if kind == "warthog" {
+                                0
+                            } else if kind == "plasma_grenade" {
+                                100
+                            } else {
+                                200
+                            },
+                    ),
+                    authority_owner: None,
+                    current_model: asset_world::MapXModelAssetKey(name.clone()),
+                    transform,
+                    lighting_origin: [0.; 3],
+                    dobj_state: xmodel_runtime::DObjSemanticState::bind_pose(name, 1, 1),
+                    metadata: asset_world::ScriptModelMetadata {
+                        gameobject: "local_cinema_prop".into(),
+                        ..default()
+                    },
+                    gentity_number: None,
+                },
+            ));
+        }
+    }
+    for (prop, mut owner, mut xf, mut visible) in &mut existing {
+        *visible = Visibility::Hidden;
+        if prop.kind == "warthog" {
+            if let Some(v) = take.json.get("vehicle") {
+                let p = path(&v["route"], take.t);
+                let facing_t = take.t.min(n(v, "stop", 8.) - 0.04);
+                let d = path(&v["route"], facing_t + 0.02)
+                    - path(&v["route"], (facing_t - 0.02).max(0.));
+                let yaw = if d.truncate().length() > 0.01 {
+                    d.y.atan2(d.x)
+                } else {
+                    -std::f32::consts::FRAC_PI_2
+                };
+                let pitch = (-d.z).atan2(d.truncate().length().max(0.1));
+                *xf = Transform::from_translation(p).with_rotation(Quat::from_euler(
+                    EulerRot::ZYX,
+                    yaw,
+                    pitch,
+                    0.,
+                ));
+                if take.t >= n(v, "draw_start", 0.) {
+                    *visible = Visibility::Inherited;
+                }
+            }
+        } else {
+            let kind = if prop.kind == "plasma_grenade" {
+                "grenade"
+            } else {
+                "rocket"
+            };
+            if let Some(s) = battle
+                .projectiles
+                .iter()
+                .filter(|s| s.kind == kind && s.alive)
+                .nth(prop.slot)
+            {
+                *xf = Transform::from_translation(s.p)
+                    .with_rotation(Quat::from_rotation_z(take.t * 7.))
+                    .with_scale(Vec3::splat(if kind == "grenade" { 1.7 } else { 1. }));
+                *visible = Visibility::Inherited;
+            }
+        }
+        owner.transform = *xf;
+        owner.lighting_origin = xf.translation.to_array();
+    }
+}
diff --git a/crates/render_gpu/src/drawsurf/clarity.rs b/crates/render_gpu/src/drawsurf/clarity.rs
new file mode 100644
index 0000000..979d35a
--- /dev/null
+++ b/crates/render_gpu/src/drawsurf/clarity.rs
@@ -0,0 +1,197 @@
+use super::{PublishedRenderFrame, postfx::PostFxSet, scene_depth::SceneDepthTexture};
+use bevy::core_pipeline::{Core3d, Core3dSystems};
+use bevy::prelude::*;
+use bevy::render::render_resource::binding_types::{
+    sampler, texture_2d, texture_depth_2d, uniform_buffer_sized,
+};
+use bevy::render::render_resource::*;
+use bevy::render::renderer::{RenderContext, RenderDevice, RenderQueue, ViewQuery};
+use bevy::render::view::ViewTarget;
+use bevy::render::{RenderApp, RenderStartup};
+use std::num::NonZeroU64;
+
+#[derive(Resource)]
+struct ClarityGpu {
+    pipeline: CachedRenderPipelineId,
+    layout: BindGroupLayoutDescriptor,
+    sampler: Sampler,
+    params: Buffer,
+    contact_shading: bool,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+struct Params {
+    world_from_clip: [[f32; 4]; 4],
+    camera: [f32; 4],
+    viewport: [f32; 4],
+    tuning: [f32; 4],
+}
+
+fn init(
+    mut commands: Commands,
+    assets: Res<AssetServer>,
+    device: Res<RenderDevice>,
+    cache: Res<PipelineCache>,
+) {
+    let layout = BindGroupLayoutDescriptor::new(
+        "native_clarity",
+        &BindGroupLayoutEntries::sequential(
+            ShaderStages::FRAGMENT,
+            (
+                texture_2d(TextureSampleType::Float { filterable: true }),
+                sampler(SamplerBindingType::Filtering),
+                texture_depth_2d(),
+                uniform_buffer_sized(false, NonZeroU64::new(std::mem::size_of::<Params>() as u64)),
+            ),
+        ),
+    );
+    let shader = assets.load("embedded://render_gpu/drawsurf/clarity.wgsl");
+    let pipeline = cache.queue_render_pipeline(RenderPipelineDescriptor {
+        label: Some("native_clarity".into()),
+        layout: vec![layout.clone()],
+        immediate_size: 0,
+        vertex: VertexState {
+            shader: shader.clone(),
+            shader_defs: vec![],
+            entry_point: Some("vertex".into()),
+            buffers: vec![],
+        },
+        fragment: Some(FragmentState {
+            shader,
+            shader_defs: vec![],
+            entry_point: Some("fragment".into()),
+            targets: vec![Some(ColorTargetState {
+                format: TextureFormat::Rgba8Unorm,
+                blend: None,
+                write_mask: ColorWrites::ALL,
+            })],
+        }),
+        primitive: PrimitiveState {
+            cull_mode: None,
+            ..default()
+        },
+        depth_stencil: None,
+        multisample: MultisampleState::default(),
+        zero_initialize_workgroup_memory: false,
+    });
+    commands.insert_resource(ClarityGpu {
+        pipeline,
+        layout,
+        sampler: device.create_sampler(&SamplerDescriptor {
+            mag_filter: FilterMode::Linear,
+            min_filter: FilterMode::Linear,
+            ..default()
+        }),
+        params: device.create_buffer(&BufferDescriptor {
+            label: Some("native_clarity_params"),
+            size: std::mem::size_of::<Params>() as u64,
+            usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        }),
+        contact_shading: std::env::var_os("IW4L_LOCAL_MAP").is_some(),
+    });
+}
+
+fn draw(
+    view: ViewQuery<(&ViewTarget, &SceneDepthTexture)>,
+    gpu: Res<ClarityGpu>,
+    frame: Res<PublishedRenderFrame>,
+    device: Res<RenderDevice>,
+    queue: Res<RenderQueue>,
+    cache: Res<PipelineCache>,
+    mut context: RenderContext,
+    mut announced: Local<bool>,
+) {
+    let (target, depth) = view.into_inner();
+    if target.main_texture_format() != TextureFormat::Rgba8Unorm {
+        return;
+    }
+    let Some(pipeline) = cache.get_render_pipeline(gpu.pipeline) else {
+        return;
+    };
+    let Some(clip) = frame.exec_frame.clip_from_world else {
+        return;
+    };
+    let camera = frame.exec_frame.view_origin;
+    let size = depth.texture.size();
+    let params = Params {
+        world_from_clip: clip.inverse().to_cols_array_2d(),
+        camera: [camera.x, camera.y, camera.z, 1.0],
+        viewport: [
+            size.width as f32,
+            size.height as f32,
+            1.0 / size.width as f32,
+            1.0 / size.height as f32,
+        ],
+        tuning: [
+            if gpu.contact_shading { 1.0 } else { 0.0 },
+            frame
+                .exec_frame
+                .clip_from_view
+                .map_or(1.0, |m| m.y_axis.y.abs()),
+            0.0,
+            0.0,
+        ],
+    };
+    queue.write_buffer(&gpu.params, 0, bytemuck::bytes_of(&params));
+    let post = target.post_process_write();
+    let bind = device.create_bind_group(
+        Some("native_clarity"),
+        &cache.get_bind_group_layout(&gpu.layout),
+        &BindGroupEntries::sequential((
+            post.source,
+            &gpu.sampler,
+            depth.view(),
+            gpu.params.as_entire_buffer_binding(),
+        )),
+    );
+    let attachments = [Some(RenderPassColorAttachment {
+        view: post.destination,
+        resolve_target: None,
+        depth_slice: None,
+        ops: Operations {
+            load: LoadOp::Clear(LinearRgba::BLACK.into()),
+            store: StoreOp::Store,
+        },
+    })];
+    let mut pass = context
+        .command_encoder()
+        .begin_render_pass(&RenderPassDescriptor {
+            label: Some("native_clarity"),
+            color_attachments: &attachments,
+            depth_stencil_attachment: None,
+            timestamp_writes: None,
+            occlusion_query_set: None,
+            multiview_mask: None,
+        });
+    pass.set_pipeline(pipeline);
+    pass.set_bind_group(0, &bind, &[]);
+    pass.draw(0..3, 0..1);
+    if !*announced {
+        diag::info!(
+            World,
+            "native clarity: READY edge-AA=true contact-shading={}",
+            gpu.contact_shading
+        );
+        *announced = true;
+    }
+}
+
+#[derive(SystemSet, Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub(super) struct ClaritySet;
+
+pub(super) fn register(app: &mut App) {
+    if std::env::var("IW4L_CLARITY").as_deref() == Ok("0") {
+        return;
+    }
+    bevy::asset::embedded_asset!(app, "clarity.wgsl");
+    if let Some(render_app) = app.get_sub_app_mut(RenderApp) {
+        render_app.add_systems(RenderStartup, init).add_systems(
+            Core3d,
+            draw.in_set(Core3dSystems::PostProcess)
+                .in_set(ClaritySet)
+                .after(PostFxSet),
+        );
+    }
+}
diff --git a/crates/render_gpu/src/drawsurf/clarity.wgsl b/crates/render_gpu/src/drawsurf/clarity.wgsl
new file mode 100644
index 0000000..9d0442c
--- /dev/null
+++ b/crates/render_gpu/src/drawsurf/clarity.wgsl
@@ -0,0 +1,71 @@
+struct Params {
+    world_from_clip: mat4x4<f32>,
+    camera: vec4<f32>,
+    viewport: vec4<f32>,
+    tuning: vec4<f32>,
+}
+@group(0) @binding(0) var scene: texture_2d<f32>;
+@group(0) @binding(1) var linear_sampler: sampler;
+@group(0) @binding(2) var depth: texture_depth_2d;
+@group(0) @binding(3) var<uniform> params: Params;
+
+@vertex fn vertex(@builtin(vertex_index) id: u32) -> @builtin(position) vec4<f32> {
+    let uv = vec2<f32>(f32((id << 1u) & 2u), f32(id & 2u));
+    return vec4<f32>(uv * 2.0 - 1.0, 0.0, 1.0);
+}
+fn color(uv: vec2<f32>) -> vec3<f32> { return textureSampleLevel(scene, linear_sampler, uv, 0.0).rgb; }
+fn luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }
+fn edge_aa(uv: vec2<f32>) -> vec3<f32> {
+    let px = params.viewport.zw;
+    let center = color(uv);
+    let nw = luma(color(uv + px * vec2<f32>(-1.0, -1.0)));
+    let ne = luma(color(uv + px * vec2<f32>(1.0, -1.0)));
+    let sw = luma(color(uv + px * vec2<f32>(-1.0, 1.0)));
+    let se = luma(color(uv + px * vec2<f32>(1.0, 1.0)));
+    let mid = luma(center);
+    let low = min(mid, min(min(nw, ne), min(sw, se)));
+    let high = max(mid, max(max(nw, ne), max(sw, se)));
+    if high - low < max(0.035, high * 0.14) { return center; }
+    var direction = vec2<f32>(-((nw+ne)-(sw+se)), (nw+sw)-(ne+se));
+    let reduce = max((nw+ne+sw+se)*0.03125, 0.0078125);
+    direction = clamp(direction / (min(abs(direction.x), abs(direction.y)) + reduce), vec2<f32>(-8.0), vec2<f32>(8.0))*px;
+    let a = 0.5*(color(uv + direction*(-1.0/6.0)) + color(uv + direction*(1.0/6.0)));
+    let b = a*0.5 + 0.25*(color(uv-direction*0.5) + color(uv+direction*0.5));
+    return select(b, a, luma(b)<low || luma(b)>high);
+}
+fn depth_at(pixel: vec2<f32>) -> f32 {
+    return textureLoad(depth, clamp(vec2<i32>(pixel), vec2<i32>(0), vec2<i32>(params.viewport.xy)-1), 0);
+}
+fn world_at(pixel: vec2<f32>) -> vec3<f32> {
+    let uv = (floor(pixel)+0.5)*params.viewport.zw;
+    let h = params.world_from_clip * vec4<f32>(uv.x*2.0-1.0, 1.0-uv.y*2.0, depth_at(pixel), 1.0);
+    return h.xyz/h.w;
+}
+fn contact_shade(pixel: vec2<f32>) -> f32 {
+    let d = depth_at(pixel);
+    if params.tuning.x == 0.0 || d < 0.03 || d > 0.99999 { return 1.0; }
+    let p = world_at(pixel);
+    let left = p-world_at(pixel-vec2<f32>(1.0,0.0));
+    let right = world_at(pixel+vec2<f32>(1.0,0.0))-p;
+    let up = p-world_at(pixel-vec2<f32>(0.0,1.0));
+    let down = world_at(pixel+vec2<f32>(0.0,1.0))-p;
+    let dx = select(left, right, dot(left,left)>dot(right,right));
+    let dy = select(up, down, dot(up,up)>dot(down,down));
+    let n0 = cross(dx,dy);
+    if dot(n0,n0)<0.000001 { return 1.0; }
+    var normal = normalize(n0);
+    if dot(normal,params.camera.xyz-p)<0.0 { normal = -normal; }
+    let radius = clamp(32.0*params.viewport.y*0.5*params.tuning.y/max(distance(params.camera.xyz,p),32.0),2.0,28.0);
+    var occ = 0.0;
+    for(var i=0; i<8; i++) {
+        let angle = f32(i)*0.785398;
+        let q = world_at(pixel + vec2<f32>(cos(angle),sin(angle))*radius);
+        let delta = q-p;
+        let dist = length(delta);
+        occ += max(dot(normal,delta)/max(dist,0.1)-0.12,0.0)*max(1.0-dist/48.0,0.0);
+    }
+    return clamp(1.0-occ*0.16,0.72,1.0);
+}
+@fragment fn fragment(@builtin(position) position: vec4<f32>) -> @location(0) vec4<f32> {
+    return vec4<f32>(edge_aa(position.xy*params.viewport.zw)*contact_shade(position.xy),1.0);
+}
