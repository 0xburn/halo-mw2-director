+// Monotone Hermite paths preserve velocity through waypoints without leaving
+// the narrow ramp. Reversals ease through zero instead of teleporting velocity.
+fn position(a: &Actor, t: f32) -> Vec3 {
+    let rows = &a.route;
+    let point = |i: usize| Vec3::new(rows[i][1], rows[i][2], rows[i][3]);
+    let slope = |i: usize, j: usize| (point(j) - point(i)) / (rows[j][0] - rows[i][0]).max(0.001);
+    let tangent = |i: usize| {
+        if i == 0 {
+            return slope(0, 1.min(rows.len() - 1));
+        }
+        if i + 1 == rows.len() {
+            return Vec3::ZERO;
+        }
+        let before = slope(i - 1, i);
+        let after = slope(i, i + 1);
+        Vec3::from_array(std::array::from_fn(|k| {
+            if before[k] * after[k] <= 0. {
+                0.
+            } else {
+                2. * before[k] * after[k] / (before[k] + after[k])
+            }
+        }))
+    };
+    for i in 0..rows.len() - 1 {
+        if t < rows[i + 1][0] {
+            let h = rows[i + 1][0] - rows[i][0];
+            let u = ((t - rows[i][0]) / h).clamp(0., 1.);
+            return point(i) * (2. * u * u * u - 3. * u * u + 1.)
+                + tangent(i) * h * (u * u * u - 2. * u * u + u)
+                + point(i + 1) * (-2. * u * u * u + 3. * u * u)
+                + tangent(i + 1) * h * (u * u * u - u * u);
+        }
+    }
+    point(rows.len() - 1)
+}
+fn delta_angle(a: f32, b: f32) -> f32 {
+    (b - a + 180.).rem_euclid(360.) - 180.
+}
+fn input(
+    a: &Actor,
+    t: f32,
+    dt: f32,
+    ps: &PlayerState,
+    world: &net::AuthorityWorld,
+    presented: &net::PresentedSnapshot,
+    motion: &mut AimMotion,
+) -> ScriptedBotCommand {
+    let origin = Vec3::from_array(ps.origin);
+    let goal = position(a, t);
+    let err = goal - origin;
+    let mut angles = [0., a.yaw, 0.];
+    let mut turn_speed = 780.;
+    let mut response = 32.;
+    let mut along = position(a, t + 0.45) - origin;
+    if a.id == 0 {
+        along.y = along.y.max(60.);
+    }
+    if along.truncate().length() > 12. {
+        angles[1] = along.y.atan2(along.x).to_degrees();
+    }
+    for cue in &a.aim {
+        if t < n(cue, "start", 0.) || t >= n(cue, "end", 999.) {
+            continue;
+        }
+        turn_speed = n(cue, "turn_speed", 780.);
+        response = n(cue, "response", 32.);
+        let mut target = if let Some(id) = cue["actor"].as_u64() {
+            let target_ps = if a.id == 0 {
+                presented.player(sim::ClientId(id as u32))
+            } else {
+                world.0.player(sim::ClientId(id as u32))
+            };
+            target_ps.map(|s| {
+                Vec3::from_array(s.origin)
+                    + Vec3::Z * n(cue, "height", 48.).min((s.view_height_current - 8.).max(24.))
+            })
+        } else {
+            serde_json::from_value::<[f32; 3]>(cue["point"].clone())
+                .ok()
+                .map(Vec3::from_array)
+        };
+        if let Some(p) = target.as_mut() {
+            p.x += n(cue, "offset_x", 0.);
+            p.y += n(cue, "offset_y", 0.);
+            p.z += n(cue, "offset_z", 0.);
+        }
+        if let Some(target) = target {
+            let d = target - origin - Vec3::Z * ps.view_height_current;
+            angles = [
+                (-d.z).atan2(d.truncate().length()).to_degrees(),
+                d.y.atan2(d.x).to_degrees(),
+                0.,
+            ];
+        }
+    }
+    let buttons = a
+        .buttons
+        .iter()
+        .filter(|b| t >= b[0] && t < b[1])
+        .fold(0u32, |bits, b| bits | b[2] as u32);
+    let travel_yaw = along.y.atan2(along.x).to_degrees();
+    if a.id != 0
+        && buttons & playerstate_iw4::buttons::SPRINT != 0
+        && buttons & playerstate_iw4::buttons::ADS == 0
+    {
+        angles = [0., travel_yaw, 0.];
+        turn_speed = 440.;
+        response = 22.;
+    }
+    // High sensitivity, not cinematic float: fast flicks with finite acceleration,
+    // slight overshoot and hand corrections. Never snap to the target on a shot.
+    if !motion.initialized {
+        motion.angles = ps.viewangles;
+        motion.initialized = true;
+    }
+    let phase = a.id as f32 * 1.7;
+    angles[0] += 0.12 * (t * 9.3 + phase).sin() + 0.045 * (t * 31.1 + phase).sin();
+    angles[1] += 0.20 * (t * 7.1 + phase).sin() + 0.07 * (t * 27.3 + phase).sin();
+    let steps = (dt.clamp(0.001, 0.08) * 240.).ceil() as usize;
+    let h = dt.clamp(0.001, 0.08) / steps as f32;
+    for _ in 0..steps {
+        for k in 0..2 {
+            let error = delta_angle(motion.angles[k], angles[k]);
+            let acceleration = (response * response * error
+                - 2. * 0.78 * response * motion.velocity[k])
+                .clamp(-14000., 14000.);
+            motion.velocity[k] =
+                (motion.velocity[k] + acceleration * h).clamp(-turn_speed, turn_speed);
+            motion.angles[k] += motion.velocity[k] * h;
+        }
+    }
+    angles = motion.angles;
+    let yaw = angles[1].to_radians();
+    let feed_forward = (position(a, t + 0.04) - position(a, (t - 0.04).max(0.))) / 0.08;
+    let mut velocity = feed_forward.truncate() + err.truncate() * 2.8;
+    if a.id == 0 {
+        velocity.y = velocity.y.max(0.);
+    }
+    let forward = velocity.dot(Vec2::new(yaw.cos(), yaw.sin()));
+    let right = velocity.dot(Vec2::new(yaw.sin(), -yaw.cos()));
+    let mut out = ScriptedBotCommand {
+        viewangles: angles,
+        forwardmove: (forward / 190. * 127.).clamp(-127., 127.) as i8,
+        rightmove: (right / 190. * 127.).clamp(-127., 127.) as i8,
+        buttons: 0,
+    };
+    for b in &a.buttons {
+        if t >= b[0] && t < b[1] {
+            out.buttons |= b[2] as u32;
+        }
+    }
+    if out.buttons & playerstate_iw4::buttons::SPRINT != 0
+        && out.buttons & playerstate_iw4::buttons::ADS == 0
+    {
+        // Finish the flick back onto the narrow ramp before pushing full forward.
+        if delta_angle(angles[1], if a.id == 0 { 90. } else { travel_yaw }).abs() < 20. {
+            out.forwardmove = 127;
+            out.rightmove = out.rightmove.clamp(-28, 28);
+        } else {
+            out.buttons &= !playerstate_iw4::buttons::SPRINT;
+        }
+    }
+    if a.id == 0 && out.buttons & playerstate_iw4::buttons::ATTACK != 0 {
+        let pitch = out.viewangles[0].to_radians();
+        let yaw = out.viewangles[1].to_radians();
+        let start = origin + Vec3::Z * ps.view_height_current;
+        let dir = Vec3::new(
+            pitch.cos() * yaw.cos(),
+            pitch.cos() * yaw.sin(),
+            -pitch.sin(),
+        );
+        let hit = world.0.bullet_trace(
+            sim::BulletTraceQuery {
+                start: start.to_array(),
+                end: (start + dir * 2000.).to_array(),
+                mask: sim::MASK_SHOT,
+                ignore: Some(sim::ClientId(0)),
+                ignore_hit: None,
+                ignore_model: None,
+            },
+            None,
+        );
+        diag::info!(
+            Launch,
+            "CINEMA AIM t={t:.3} ads={:.2} hit={hit:?}",
+            ps.f_weapon_pos_frac
+        );
+    }
+    if ps.health <= 0 {
+        out.forwardmove = 0;
+        out.rightmove = 0;
+        out.buttons = 0;
+    }
+    out
+}
+fn control(
+    time: Res<Time<Real>>,
+    take: Res<Take>,
+    world: Option<Res<net::AuthorityWorld>>,
+    prediction: Res<net::ClientPredictionState>,
+    presented: Res<net::PresentedSnapshot>,
+    mut template: ResMut<net::ClientCmdTemplate>,
+    mut look: ResMut<net::LookState>,
+    mut bots: ResMut<ScriptedBotCommands>,
+    mut controllers: ResMut<Controllers>,
+) {
+    let Some(world) = world else {
+        return;
+    };
+    bots.0.clear();
+    if take.stage < 2 {
+        controllers.0.clear();
+        return;
+    }
+    for a in &take.actors {
+        let ps = if a.id == 0 {
+            prediction.0.predicted_local()
+        } else {
+            world.0.player(sim::ClientId(a.id))
+        };
+        let Some(ps) = ps else {
+            continue;
+        };
+        let mut out = input(
+            a,
+            if take.stage == 2 { 0. } else { take.t },
+            time.delta_secs(),
+            ps,
+            &world,
+            &presented,
+            controllers.0.entry(a.id).or_default(),
+        );
+        if take.stage == 2 || take.stage == 4 {
+            out.forwardmove = 0;
+            out.rightmove = 0;
+            out.buttons = 0;
+        }
+        if a.id == 0 {
+            template.cmd.angles = net::look_angles_from_degrees(std::array::from_fn(|k| {
+                out.viewangles[k] - ps.delta_angles[k]
+            }));
+            look.angles = template.cmd.angles;
+            template.cmd.forwardmove = out.forwardmove;
+            template.cmd.rightmove = out.rightmove;
+            template.cmd.buttons = out.buttons;
+        } else {
+            bots.0.insert(a.id, out);
+        }
+    }
+}
+fn camera(
+    take: Res<Take>,
+    presented: Res<net::PresentedSnapshot>,
+    world: Option<Res<net::AuthorityWorld>>,
+    mut cameras: Query<&mut Transform, With<FlyCamera>>,
+    mut lenses: Query<&mut Projection, With<FpvLens>>,
+) {
+    let Some(death) = take.death else {
+        return;
+    };
+    let elapsed = take.t - death - n(&take.json, "cut_delay", 1.1);
+    if elapsed <= 0. {
+        return;
+    }
+    if let Some(cuts) = take.json["camera_cuts"].as_array() {
+        if let Some(shot) = cuts.iter().rev().find(|shot| take.t >= n(shot, "at", 0.)) {
+            if let (Ok(eye), Ok(focus)) = (
+                serde_json::from_value::<[f32; 3]>(shot["eye"].clone()),
+                serde_json::from_value::<[f32; 3]>(shot["focus"].clone()),
+            ) {
+                let mut eye = Vec3::from_array(eye);
+                let mut focus = Vec3::from_array(focus);
+                if let Some(id) = shot["follow_actor"].as_u64() {
+                    if let Some(ps) = presented.player(sim::ClientId(id as u32)) {
+                        let origin = Vec3::from_array(ps.origin);
+                        eye += origin;
+                        focus += origin;
+                    }
+                }
+                for mut c in &mut cameras {
+                    *c = Transform::from_translation(eye).looking_at(focus, Vec3::Z);
+                }
+                for mut p in &mut lenses {
+                    if let Projection::Perspective(lens) = &mut *p {
+                        lens.fov = n(shot, "fov", 58.).to_radians();
+                    }
+                }
+                return;
+            }
+        }
+    }
+    let Some(world) = world else {
+        return;
+    };
+    let Some(chief) = world.0.player(sim::ClientId(8)) else {
+        return;
+    };
+    let target = Vec3::from_array(chief.origin) + Vec3::Z * 45.;
+    let close = Vec3::new(513., 680., 180.);
+    let wide = if take.json.get("vehicle").is_some() {
+        Vec3::new(-100., -30., 350.)
+    } else {
+        Vec3::new(-450., -650., 700.)
+    };
+    let u = (elapsed
+        / if take.json.get("vehicle").is_some() {
+            4.
+        } else {
+            9.
+        })
+    .clamp(0., 1.);
+    let u = u * u * (3. - 2. * u);
+    let eye = close.lerp(wide, u);
+    let focus = target.lerp(Vec3::new(510., 600., 30.), u);
+    for mut c in &mut cameras {
+        *c = Transform::from_translation(eye).looking_at(focus, Vec3::Z);
+    }
+    for mut p in &mut lenses {
+        if let Projection::Perspective(lens) = &mut *p {
+            lens.fov = (55. + u * 15.).to_radians();
+        }
+    }
+}
+fn hide_gun(take: Res<Take>, mut plan: ResMut<FpvDrawPlan>) {
+    if take
+        .death
+        .is_some_and(|d| take.t > d + n(&take.json, "cut_delay", 1.1))
+    {
+        plan.drawgun = Some(0);
+        plan.visible = false;
+    }
+}
