+//! Opt-in local CE mesh bridge. Retail files and normal game loads are untouched.
+use std::{fs, path::Path, sync::Arc};
+use bevy::render::render_resource::{Extent3d, TextureFormat};
+use serde_json::Value;
+use asset_core::{AssetRef, MaterialKey};
+use asset_model::{ModelLodSelector, VertSkin};
+
+pub(crate) fn install(prepared: &mut crate::PreparedMatch) -> Result<(), String> {
+    let Some(path) = std::env::var_os("IW4L_CHIEF_PACK") else { return Ok(()); };
+    if prepared.bodies.get("mp_body_halo_chief").is_some() { return Ok(()); }
+    let path = Path::new(&path);
+    let pack: Value = serde_json::from_slice(&fs::read(path.join("chief.json")).map_err(|e|e.to_string())?).map_err(|e|e.to_string())?;
+    let mut entry = prepared.bodies.get(pack["template"].as_str().ok_or("missing template")?)
+        .ok_or("Chief template body is absent")?.clone();
+    entry.skel.name="mp_body_halo_chief".into();
+    if let Some(pose)=entry.skel.pose.as_mut(){pose.name=entry.skel.name.clone();}
+    replace_mesh(&mut entry.skel,&mut entry.material_keys,&mut entry.material_edges,Arc::make_mut(&mut prepared.materials.population),path,&pack,"vertices.bin")?;
+    Arc::make_mut(&mut prepared.bodies).install_local_axis(entry);
+    Arc::make_mut(&mut prepared.weapons).configure_local_sniper_hipfire();
+    let pack:Value=serde_json::from_slice(&fs::read(path.join("sniper.json")).map_err(|e|e.to_string())?).map_err(|e|e.to_string())?;
+    let name=pack["template"].as_str().ok_or("sniper template missing")?;
+    let index=prepared.world_weapons.index_by_name(asset_core::AssetNamespace::Iw4,name).ok_or("sniper template absent")?;
+    let mut weapon=prepared.world_weapons.get_at(index).ok_or("sniper template absent")?.clone();
+    replace_mesh(Arc::make_mut(&mut weapon.skel),&mut weapon.material_keys,&mut weapon.material_edges,Arc::make_mut(&mut prepared.materials.population),path,&pack,"sniper-vertices.bin")?;
+    prepared.world_weapons.replace_local_model(index,weapon);
+    install_battlefield(prepared, path)?;
+    diag::info!(World,"local Halo CE Chief, weapons and battlefield props installed for native cinema");
+    Ok(())
+}
+
+fn install_battlefield(prepared: &mut crate::PreparedMatch, path: &Path) -> Result<(),String> {
+    let ns=asset_core::AssetNamespace::Iw4;
+    let base=prepared.world_weapons.index_by_name(ns,"weapon_wa2000").ok_or("missing prop template")?;
+    for name in ["warthog","plasma_grenade","rocket_projectile","plasma_pistol","rocket"] {
+        let file=path.join(format!("{name}.json"));
+        if !file.exists() {continue;}
+        let pack:Value=serde_json::from_slice(&fs::read(file).map_err(|e|e.to_string())?).map_err(|e|e.to_string())?;
+        let target=pack["template"].as_str().unwrap_or("weapon_wa2000");
+        let index=prepared.world_weapons.index_by_name(ns,target);
+        let mut model=prepared.world_weapons.get_at(index.unwrap_or(base)).unwrap().clone();
+        replace_mesh(Arc::make_mut(&mut model.skel),&mut model.material_keys,&mut model.material_edges,Arc::make_mut(&mut prepared.materials.population),path,&pack,&format!("{name}-vertices.bin"))?;
+        if name=="plasma_pistol" || name=="rocket" {
+            if let Some(index)=index {prepared.world_weapons.replace_local_model(index,model.clone());}
+            if name=="plasma_pistol" {
+                if let Some(other)=prepared.world_weapons.index_by_name(ns,"weapon_usp_45") {
