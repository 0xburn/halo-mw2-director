diff --git a/crates/assets/src/gltf_export.rs b/crates/assets/src/gltf_export.rs
index f39c9aa..531a8cf 100644
--- a/crates/assets/src/gltf_export.rs
+++ b/crates/assets/src/gltf_export.rs
@@ -783,3 +783,58 @@ fn write_png(path: &Path, image: &PendingImage) -> Result<(), String> {
         .write_image_data(&image.pixels)
         .map_err(|error| format!("PNG pixels {}: {error}", path.display()))
 }
+
+
+/// Local asset bridge: preserve source skeletons and material bindings for the
+/// cinematic preview. Geometry remains in IW inches/Z-up in this interchange.
+pub fn export_cinema_sources(prepared: &crate::PreparedMatch, output: &Path) -> Result<(), String> {
+    fs::create_dir_all(output.join("textures")).map_err(|e| e.to_string())?;
+    let catalog = &prepared.materials.population;
+    let mut models = Vec::new();
+    for name in prepared.bodies.names() {
+        let entry = prepared.bodies.get(name).unwrap();
+        models.push(cinema_skel(&entry.skel, &entry.material_keys));
+    }
+    for i in 0..prepared.world_weapons.len() {
+        let entry = prepared.world_weapons.get_at(i).unwrap();
+        if ["cheytac", "barrett", "wa2000", "m21"].iter().any(|n| entry.skel.name.contains(n)) {
+            models.push(cinema_skel(&entry.skel, &entry.material_keys));
+        }
+    }
+    let materials = catalog.materials.iter().map(|m| json!({
+        "name": m.name.as_str(), "sky": catalog.is_sky(m), "technique": m.technique_set.as_str(),
+        "textures": m.textures.iter().map(|t| json!({"semantic":t.semantic,"image":t.image})).collect::<Vec<_>>()
+    })).collect::<Vec<_>>();
+    let mut images = Vec::new();
+    for (i, source) in catalog.images.iter().enumerate() {
+        let Some(decoded) = &source.decoded else { continue; };
+        let layers = decoded.texture_descriptor.size.depth_or_array_layers;
+        let mut paths = Vec::new();
+        for face in 0..layers.min(6) {
+            let mut single = (**decoded).clone();
+            if layers > 1 {
+                single.texture_descriptor.size.depth_or_array_layers = 1;
+                single.texture_descriptor.mip_level_count = 1;
+                let bytes = decoded.data.as_ref().map(|b| b.len() / layers as usize).unwrap_or(0);
+                single.data = decoded.data.as_ref().map(|b| b[face as usize*bytes..(face as usize+1)*bytes].to_vec());
+            }
+            if let Ok((width,height,pixels)) = asset_material::decoded_image_top_level_rgba8(&single) {
+                let file_name = format!("image-{i}-{face}.png");
+                write_png(&output.join("textures").join(&file_name), &PendingImage {file_name: file_name.clone(),width,height,pixels})?;
+                paths.push(format!("textures/{file_name}"));
+            }
+        }
+        images.push(json!({"index":i,"name":source.name.as_str(),"paths":paths}));
+    }
+    let value = json!({"models":models,"materials":materials,"images":images});
+    fs::write(output.join("catalog.json"),serde_json::to_vec(&value).map_err(|e|e.to_string())?).map_err(|e| e.to_string())?;
+    Ok(())
+}
+fn cinema_skel(s: &asset_model::ModelSkel, materials: &[Option<asset_core::MaterialKey>]) -> Value {
+    json!({"name":s.name,"positions":s.positions,"normals":s.normals,"uvs":s.uvs,"indices":s.indices,
+        "surfaces":s.surface_index_ranges,"lod0": [s.surfaces_for_lod(0).start,s.surfaces_for_lod(0).end],
+        "materials":materials.iter().map(|m|m.as_ref().map(|k|k.name.as_str())).collect::<Vec<_>>(),
+        "bones":s.bones.iter().enumerate().map(|(i,b)|json!({"name":s.bone_names[i],"parent":s.parent_of(i),"rotation":b.quat,"translation":b.trans})).collect::<Vec<_>>(),
+        "joints":s.vert_skin.iter().map(|v|v.bones).collect::<Vec<_>>(),
+        "weights":s.vert_skin.iter().map(|v|v.weights).collect::<Vec<_>>()})
+}
