+// Monotone cubic route: continuous velocity through turns, no sideways snaps.
+fn path(rows: &serde_json::Value, t: f32) -> Vec3 {
+    let Some(rows) = rows.as_array() else {
+        return Vec3::ZERO;
+    };
+    if rows.is_empty() {
+        return Vec3::ZERO;
+    }
+    let point = |i: usize| {
+        Vec3::new(
+            rows[i][1].as_f64().unwrap() as f32,
+            rows[i][2].as_f64().unwrap() as f32,
+            rows[i][3].as_f64().unwrap() as f32,
+        )
+    };
+    let at = |i: usize| rows[i][0].as_f64().unwrap() as f32;
+    let slope = |i: usize, j: usize| (point(j) - point(i)) / (at(j) - at(i)).max(0.001);
+    let tangent = |i: usize| {
+        if i == 0 {
+            return slope(0, 1.min(rows.len() - 1));
+        }
+        if i + 1 == rows.len() {
+            return Vec3::ZERO;
+        }
+        let a = slope(i - 1, i);
+        let b = slope(i, i + 1);
+        Vec3::from_array(std::array::from_fn(|k| {
+            if a[k] * b[k] <= 0. {
+                0.
+            } else {
+                2. * a[k] * b[k] / (a[k] + b[k])
+            }
+        }))
+    };
+    for i in 0..rows.len() - 1 {
+        if t < at(i + 1) {
+            let h = at(i + 1) - at(i);
+            let u = ((t - at(i)) / h).clamp(0., 1.);
+            return point(i) * (2. * u * u * u - 3. * u * u + 1.)
+                + tangent(i) * h * (u * u * u - 2. * u * u + u)
+                + point(i + 1) * (-2. * u * u * u + 3. * u * u)
+                + tangent(i + 1) * h * (u * u * u - u * u);
+        }
+    }
+    point(rows.len() - 1)
+}
