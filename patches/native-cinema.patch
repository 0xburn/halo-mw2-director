+use std::{fs, path::Path, sync::Arc};
+
+use asset_core::AssetRef;
+use asset_world::*;
+use bevy::render::render_resource::{Extent3d, TextureFormat};
+use dpvs_iw4::{AabbNodeView, Bounds, SurfRange};
+use serde_json::Value;
+
+fn array3(v: &Value) -> Result<Vec<[f32; 3]>, String> {
+    let rows: Vec<[f32; 3]> = serde_json::from_value(v.clone()).map_err(|e| e.to_string())?;
+    if rows.iter().flatten().any(|n| !n.is_finite()) {
+        return Err("non-finite map coordinate".into());
+    }
+    Ok(rows)
+}
+
+fn integer(v: &Value) -> Result<usize, String> {
+    v.as_u64()
+        .and_then(|n| usize::try_from(n).ok())
+        .ok_or_else(|| "invalid map index".into())
+}
+
+fn bounds(positions: &[[f32; 3]]) -> Bounds {
+    let mut min = [f32::INFINITY; 3];
+    let mut max = [f32::NEG_INFINITY; 3];
+    for p in positions {
+        for k in 0..3 {
+            min[k] = min[k].min(p[k]);
+            max[k] = max[k].max(p[k]);
+        }
+    }
+    Bounds::from_mins_maxs(min, max)
+}
+
+fn texture_path(path: &Path, file: &Value) -> Result<std::path::PathBuf, String> {
+    let file = file.as_str().ok_or("missing texture file")?;
+    if file.is_empty() || file.contains('/') || file.contains('\\') || file == ".." {
+        return Err("map texture must be beside map.json".into());
+    }
+    Ok(path.join(file))
+}
+
+pub(crate) fn install(prepared: &mut crate::PreparedMatch) -> Result<(), String> {
+    let Some(path) = std::env::var_os("IW4L_LOCAL_MAP") else {
+        return Ok(());
+    };
+    let path = Path::new(&path);
+    let bytes = fs::read(path.join("map.json")).map_err(|e| e.to_string())?;
+    let pack: Value = serde_json::from_slice(&bytes).map_err(|e| e.to_string())?;
+    if pack["version"] != 1 || pack["units"] != "inches" {
+        return Err("unsupported local map format".into());
+    }
+    let name = pack["name"].as_str().ok_or("missing local map name")?;
+    if !name
+        .bytes()
+        .all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'-')
+    {
+        return Err("invalid local map name".into());
+    }
+    let positions = array3(&pack["positions"])?;
+    let normals = array3(&pack["normals"])?;
+    let uvs: Vec<[f32; 2]> =
+        serde_json::from_value(pack["uvs"].clone()).map_err(|e| e.to_string())?;
+    let indices: Vec<u32> =
+        serde_json::from_value(pack["indices"].clone()).map_err(|e| e.to_string())?;
+    let n = positions.len();
+    if n == 0
+        || n > 1_000_000
+        || normals.len() != n
+        || uvs.len() != n
+        || uvs.iter().flatten().any(|v| !v.is_finite())
+        || indices.len() % 3 != 0
+        || indices.iter().any(|i| *i as usize >= n)
+    {
+        return Err("invalid local map geometry".into());
+    }
+    let rows = pack["surfaces"].as_array().ok_or("missing surfaces")?;
+    if rows.is_empty() || rows.len() > 65535 {
+        return Err("invalid map surface count".into());
+    }
+    let definitions = Arc::make_mut(&mut prepared.materials.population);
+    let candidates: Vec<_> = definitions
+        .materials
+        .iter()
+        .enumerate()
+        .filter(|(_, m)| {
+            matches!(
+                m.route.map(|r| r.pass),
+                Some(asset_iw4::MaterialPass::Unlit)
+            ) && m
+                .textures
+                .iter()
+                .any(|t| t.semantic == asset_material::TS_COLOR_MAP && t.image.is_some())
+        })
+        .collect();
+    let template = candidates
+        .iter()
+        .find(|(_, m)| m.technique_set.as_str() == "wc_unlit_multiply_lin")
+        .map(|(i, _)| *i)
+        .ok_or("native unlit replacement material unavailable")?;
+    let mut original = definitions.materials[template].clone();
+    let facts = definitions
+        .technique_set_facts()
+        .iter()
+        .find(|f| f.namespace == original.namespace && f.name == original.technique_set)
+        .ok_or("world texture technique unavailable")?
+        .clone();
+    // An authored RGBA sample pass preserves Halo cutout alpha without the
+    // retail decal's multiply/fog passes. It uses the existing native world VS.
+    // ps_3_0; dcl_texcoord0 v0; dcl_2d s0; texld r0,v0,s0; mov oC0,r0; end.
+    let words: [u32; 15] = [
+        0xffff0300,
+        sm3_instruction(0x1f, 2),
+        0x80000005,
+        0x900f0000,
+        sm3_instruction(0x1f, 2),
+        0x90000000,
+        0xa00f0800,
+        sm3_instruction(0x42, 3),
+        0x800f0000,
+        0x90e40000,
+        0xa0e40800,
+        sm3_instruction(0x01, 2),
+        0x800f0800,
+        0x80e40000,
+        0x0000ffff,
+    ];
+    let source_pixel = facts
+        .table
+        .as_ref()
+        .and_then(|t| t.graph.as_ref())
+        .and_then(|g| g.slots.get(4))
+        .and_then(Option::as_ref)
+        .and_then(|t| t.passes.first())
+        .and_then(|p| p.pixel_shader.shader)
+        .ok_or("world texture pixel shader unavailable")?;
+    let mut pixel = definitions.shaders[source_pixel].clone();
+    pixel.name = AssetRef::Real(format!("local_map/{name}/rgba"));
+    pixel.program = words.into_iter().flat_map(u32::to_le_bytes).collect();
+    let pixel_index = definitions.shaders.len();
+    definitions.shaders.push(pixel);
+    let install_technique = |water: bool, definitions: &mut asset_material::MaterialDefinitions| {
+        let mut facts = facts.clone();
+        let shader = if water {
+            let mut pixel = definitions.shaders[pixel_index].clone();
+            pixel.name = AssetRef::Real(format!("local_map/{name}/flow"));
+            pixel.program = water_program()
+                .into_iter()
+                .flat_map(u32::to_le_bytes)
+                .collect();
+            let index = definitions.shaders.len();
+            definitions.shaders.push(pixel);
+            index
+        } else {
+            pixel_index
+        };
+        let table = facts.table.as_mut().expect("checked technique table");
+        let graph = table.graph.as_mut().expect("checked technique graph");
+        for (i, technique) in graph.slots.iter_mut().enumerate() {
+            if let Some(technique) = technique {
+                technique.passes.truncate(1);
+                let pass = &mut technique.passes[0];
+                pass.pixel_shader.shader = Some(shader);
+                if water {
+                    pass.arguments.insert(
+                        0,
+                        asset_material::OwnedShaderArgument::CodePixelConstant {
+                            destination: 220,
+                            index: 7,
+                            first_row: 0,
+                            row_count: 1,
+                        },
+                    );
+                    pass.per_prim_arg_count += 1;
+                }
+                table.pass_count_by_slot[i] = 1;
+            }
+        }
+        table.max_pass_count = 1;
+        facts.name = AssetRef::Real(format!(
+            "local_map/{name}/{}",
+            if water { "flow_world" } else { "unlit_world" }
+        ));
