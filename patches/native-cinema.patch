+    pub fn cinema_contact_damage(&mut self, _tick: Tick, attacker: ClientId, target: ClientId, origin: [f32;3], amount: i32) -> bool {
+        let mut frame=self.frame();
+        let Some(victim)=frame.client_meta(target) else{return false;};
+        let target_life=victim.life_sequence;
+        let Some(killer)=frame.client_meta(attacker) else{return false;};
+        let attacker_life=killer.life_sequence;
