 pub const CG_THIRD_PERSON_ANGLE_MP: f32 = 356.0;
 
+#[derive(Default)]
+pub struct LiveFollowCamera {
+    previous: Option<(ClientId, sim::LifeSequence, i32, [f32; 3])>,
+}
+
+impl LiveFollowCamera {
+    pub fn update(
+        &mut self,
+        presented: &PresentedSnapshot,
+        local: ClientId,
+        clip: Option<&ClipCollision>,
+        time: i32,
+    ) -> Option<WorldCameraPose> {
+        let focus = presented.spectator_target()?;
+        let ps = presented.player(local)?;
+        let life = presented.snapshot()?.meta.for_client(focus)?.life_sequence;
+        if !presented.spectator_third_person().unwrap_or(false) {
+            self.previous = None;
+            return None;
+        }
+        let clip = clip?;
+        let mut angles = [
+            math_iw4::angle_subtract(ps.viewangles[0], 0.0).clamp(-40.0, 45.0),
+            ps.viewangles[1],
+            0.0,
+        ];
+        if let Some((old_focus, old_life, old_time, old_angles)) = self.previous {
+            let dt = time.saturating_sub(old_time);
+            if old_focus == focus && old_life == life && (0..=200).contains(&dt) {
+                let blend = 1.0 - (-10.0 * dt as f32 / 1000.0).exp();
+                for k in 0..2 {
+                    angles[k] =
+                        old_angles[k] + math_iw4::angle_subtract(angles[k], old_angles[k]) * blend;
+                }
+            }
+        }
+        let yaw_lag = math_iw4::angle_subtract(ps.viewangles[1], angles[1]).clamp(-35.0, 35.0);
+        angles[1] = ps.viewangles[1] - yaw_lag;
+        self.previous = Some((focus, life, time, angles));
+        let (forward, right, _) = math_iw4::angle_vectors([0.0, angles[1], 0.0]);
+        let anchor = [
+            ps.origin[0],
+            ps.origin[1],
+            ps.origin[2] + ps.view_height_current.max(60.0) + 12.0,
+        ];
+        let desired = std::array::from_fn(|k| {
+            anchor[k] - forward[k] * 273.0 + right[k] * 42.0 + if k == 2 { 24.0 } else { 0.0 }
+        });
+        let origin = playerstate_iw4::pull_back_camera_through_brush(anchor, desired, |a, b| {
+            clip.sweep_box(a, b, [-6.0; 3], [6.0; 3], CG_CAMERA_PULLBACK_CLIPMASK)
+                .fraction
+        });
+        let direction = std::array::from_fn(|k| {
+            ps.origin[k] + forward[k] * 65.0 + if k == 2 { 40.0 - angles[0] * 0.5 } else { 0.0 }
+                - origin[k]
+        });
+        Some(WorldCameraPose {
+            origin,
+            angles: math_iw4::vect_to_angles(direction),
+        })
+    }
+}
