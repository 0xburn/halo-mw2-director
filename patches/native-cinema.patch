+        material.technique_set = facts.name.clone();
+        material.technique_table = facts.table.clone();
+        material.technique_set_edge = asset_core::AssetEdge::bind_order(
+            definitions.install_local_technique_set(facts),
+            material.zone,
+        );
+        material
+    };
+    let water_material = install_technique(true, definitions);
+    original = install_technique(false, definitions);
+
+    diag::info!(
+        World,
+        "local map material template: {} ({})",
+        original.name,
+        original.technique_set
+    );
+    let mut map_materials = Vec::new();
+    for row in pack["materials"].as_array().ok_or("missing materials")? {
+        let width = integer(&row["width"])?;
+        let height = integer(&row["height"])?;
+        if width == 0 || height == 0 || width > 8192 || height > 8192 {
+            return Err("invalid map texture size".into());
+        }
+        let pixels = fs::read(texture_path(path, &row["file"])?).map_err(|e| e.to_string())?;
+        if pixels.len() != width * height * 4 {
+            return Err("invalid map RGBA size".into());
+        }
+        let material_name = format!(
+            "local_map/{name}/{}",
+            row["name"].as_str().ok_or("missing material name")?
+        );
+        let mut material = if row["water"] == true {
+            water_material.clone()
+        } else {
+            original.clone()
+        };
+        material.name = AssetRef::Real(material_name.clone());
+        material.camera_region = asset_iw4::CAMERA_REGION_LIT_OPAQUE;
+        for bits in &mut material.state_bits {
+            bits[0] &= !(asset_material::GFXS0_SRGBWRITEENABLE
+                | 0x7ff
+                | asset_iw4::GFXS0_ATEST_DISABLE
+                | asset_iw4::GFXS0_ATEST_MASK
+                | asset_iw4::GFXS0_CULL_MASK);
+            bits[0] |= asset_iw4::GFXS0_CULL_NONE
+                | if row["alpha"] == true {
+                    asset_iw4::GFXS0_ATEST_GE_128
+                } else {
+                    asset_iw4::GFXS0_ATEST_DISABLE
+                };
+            bits[1] = (bits[1] & !0xf)
+                | asset_iw4::GFXS1_DEPTHWRITE
+                | asset_iw4::GFXS1_DEPTHTEST_LESSEQUAL;
+        }
+        let binding = material
+            .textures
+            .iter_mut()
+            .find(|t| t.semantic == asset_material::TS_COLOR_MAP)
+            .ok_or("no map diffuse sampler")?;
+        let mut image = definitions.images[binding.image.ok_or("no template image")?].clone();
+        let mut decoded = (**image.decoded.as_ref().ok_or("undecoded map template")?).clone();
+        let (pixels, levels) = mip_chain(pixels, width, height, row["alpha"] == true);
+        decoded.data = Some(pixels);
+        decoded.texture_descriptor.size = Extent3d {
+            width: width as u32,
+            height: height as u32,
+            depth_or_array_layers: 1,
+        };
+        decoded.texture_descriptor.format = TextureFormat::Rgba8Unorm;
+        decoded.texture_descriptor.mip_level_count = levels;
+        decoded.texture_view_descriptor = None;
+        image.name = AssetRef::Real(material_name);
+        image.width = width as u16;
+        image.height = height as u16;
+        image.level_count = levels as u8;
+        image.payload = Arc::new(Vec::new());
+        image.common_owned = false;
+        image.decoded_by = None;
+        image.decoded_variant = None;
+        image.pending_decode = None;
+        binding.sampler_state = if row["name"]
+            .as_str()
+            .is_some_and(|n| n.starts_with("lightmap-"))
+        {
+            0x74
+        } else {
+            0x14
+        };
+        decoded.sampler = bevy::image::ImageSampler::Descriptor(asset_material::sampler_from_iw4(
+            binding.sampler_state,
+            levels,
+            false,
+        ));
+        image.decoded = Some(Arc::new(decoded));
+        binding.image = Some(definitions.images.len());
+        definitions.images.push(image);
+        let global = definitions.materials.len();
+        definitions.materials.push(material);
+        let local = prepared.materials.map_ids.len();
+        prepared.materials.map_ids.push(Some(global));
+        map_materials.push(local);
+    }
+    let mut draw = prepared
+        .world
+        .draw
+        .take()
+        .ok_or("native base map has no world")?;
+    draw.batches.clear();
+    draw.sky_model = None;
+    draw.lightmap = Ok(Vec::new());
+    draw.vertex_layer.clear();
+    draw.surface_vertex_layer.clear();
+    draw.surface_first_vertex.clear();
+    draw.surface_draw_fields.clear();
+    draw.surface_index_ranges.clear();
+    draw.surface_batch_ranges.clear();
+    draw.surface_materials.clear();
+    draw.surface_lightmapped.clear();
+    draw.surface_lightmap_indices.clear();
+    draw.surface_reflection_probes.clear();
+    draw.surface_primary_lights.clear();
+    draw.brush_models.clear();
+    draw.brush_model_bounds.clear();
+    draw.light_region_hulls = None;
+    draw.shadow_geometry.clear();
+    draw.sun_effects = None;
+    draw.sort_key_distortion = None;
+    draw.positions = positions;
+    draw.normals = normals;
+    draw.texture_uvs = uvs;
+    draw.lightmap_uvs = vec![[0.; 2]; n];
+    draw.colors = vec![[1.; 4]; n];
+    draw.tangents = draw
+        .normals
+        .iter()
+        .map(|normal| {
+            let v = bevy::prelude::Vec3::from_array(*normal).normalize_or_zero();
+            let t = if v.z.abs() > 0.9 {
+                v.cross(bevy::prelude::Vec3::Y)
+            } else {
+                v.cross(bevy::prelude::Vec3::Z)
+            }
+            .normalize_or_zero();
+            [t.x, t.y, t.z, 1.]
+        })
+        .collect();
