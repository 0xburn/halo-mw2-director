+        };
+        if frame.player(target).is_none_or(|p|p.health<=0){return false;}
+        frame.ecs().get_resource_or_insert_with(crate::damage::CinemaDamageQueue::default).0.push(crate::damage::CinemaDamage::Contact(intent));
