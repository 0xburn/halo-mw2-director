+    for (surface, range) in ranges.iter().enumerate() {
+        for skin in &s.vert_skin[range[0]..range[0]+range[1]] {
+            for (&bone, &weight) in skin.bones.iter().zip(&skin.weights) {
+                if weight > 0. {
+                    let bone=usize::from(bone);
