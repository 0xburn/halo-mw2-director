index 0000000..576cb20
--- /dev/null
+++ b/crates/assets/src/local_chief.rs
@@ -0,0 +1,123 @@
+//! Opt-in local CE mesh bridge. Retail files and normal game loads are untouched.
+use std::{fs, path::Path, sync::Arc};
+use bevy::render::render_resource::{Extent3d, TextureFormat};
+use serde_json::Value;
+use asset_core::{AssetRef, MaterialKey};
+use asset_model::{ModelLodSelector, VertSkin};
+
+pub(crate) fn install(prepared: &mut crate::PreparedMatch) -> Result<(), String> {
+    let Some(path) = std::env::var_os("IW4L_CHIEF_PACK") else { return Ok(()); };
+    if prepared.bodies.get("mp_body_halo_chief").is_some() { return Ok(()); }
+    let path = Path::new(&path);
+    let pack: Value = serde_json::from_slice(&fs::read(path.join("chief.json")).map_err(|e|e.to_string())?).map_err(|e|e.to_string())?;
+    let mut entry = prepared.bodies.get(pack["template"].as_str().ok_or("missing template")?)
+        .ok_or("Chief template body is absent")?.clone();
+    entry.skel.name="mp_body_halo_chief".into();
+    if let Some(pose)=entry.skel.pose.as_mut(){pose.name=entry.skel.name.clone();}
+    replace_mesh(&mut entry.skel,&mut entry.material_keys,&mut entry.material_edges,Arc::make_mut(&mut prepared.materials.population),path,&pack,"vertices.bin")?;
+    Arc::make_mut(&mut prepared.bodies).install_local_axis(entry);
+    Arc::make_mut(&mut prepared.weapons).configure_local_sniper_hipfire();
+    let pack:Value=serde_json::from_slice(&fs::read(path.join("sniper.json")).map_err(|e|e.to_string())?).map_err(|e|e.to_string())?;
+    let name=pack["template"].as_str().ok_or("sniper template missing")?;
+    let index=prepared.world_weapons.index_by_name(asset_core::AssetNamespace::Iw4,name).ok_or("sniper template absent")?;
+    let mut weapon=prepared.world_weapons.get_at(index).ok_or("sniper template absent")?.clone();
+    replace_mesh(Arc::make_mut(&mut weapon.skel),&mut weapon.material_keys,&mut weapon.material_edges,Arc::make_mut(&mut prepared.materials.population),path,&pack,"sniper-vertices.bin")?;
+    prepared.world_weapons.replace_local_model(index,weapon);
+    install_battlefield(prepared, path)?;
+    diag::info!(World,"local Halo CE Chief, weapons and battlefield props installed for native cinema");
+    Ok(())
+}
+
+fn install_battlefield(prepared: &mut crate::PreparedMatch, path: &Path) -> Result<(),String> {
+    let ns=asset_core::AssetNamespace::Iw4;
+    let base=prepared.world_weapons.index_by_name(ns,"weapon_wa2000").ok_or("missing prop template")?;
+    for name in ["warthog","plasma_grenade","rocket_projectile","plasma_pistol","rocket"] {
+        let file=path.join(format!("{name}.json"));
+        if !file.exists() {continue;}
+        let pack:Value=serde_json::from_slice(&fs::read(file).map_err(|e|e.to_string())?).map_err(|e|e.to_string())?;
+        let target=pack["template"].as_str().unwrap_or("weapon_wa2000");
+        let index=prepared.world_weapons.index_by_name(ns,target);
+        let mut model=prepared.world_weapons.get_at(index.unwrap_or(base)).unwrap().clone();
+        replace_mesh(Arc::make_mut(&mut model.skel),&mut model.material_keys,&mut model.material_edges,Arc::make_mut(&mut prepared.materials.population),path,&pack,&format!("{name}-vertices.bin"))?;
+        if name=="plasma_pistol" || name=="rocket" {
+            if let Some(index)=index {prepared.world_weapons.replace_local_model(index,model.clone());}
+            if name=="plasma_pistol" {
+                if let Some(other)=prepared.world_weapons.index_by_name(ns,"weapon_usp_45") {
+                    let mut alias=model.clone();Arc::make_mut(&mut alias.skel).name="weapon_usp_45".into();
+                    prepared.world_weapons.replace_local_model(other,alias);
+                }
+            }
+            else {diag::info!(World,"cinema weapon template unavailable: {target}");}
+        }
+        let key=format!("halo_ce_{name}");
+        let skel=Arc::make_mut(&mut model.skel);skel.name=key.clone();
+        if let Some(pose)=skel.pose.as_mut(){pose.name=key.clone();}
+        skel.radius=Some(250.);
+        let materials=model.material_edges.iter().map(|e|e.bound_index().map(asset_core::MaterialIndex::from_order)).collect();
+        prepared.world.map_xmodel_scene_assets.install_local_model(key,model.skel,materials);
+    }
+    Ok(())
+}
+
+fn replace_mesh(s:&mut asset_model::ModelSkel, keys:&mut Vec<Option<MaterialKey>>, edges:&mut Vec<asset_model::AssetEdge<asset_model::MaterialSpace>>, materials:&mut asset_material::MaterialDefinitions, path:&Path, pack:&Value, vertices:&str)->Result<(),String>{
+    let source_material = keys.iter().flatten().next().ok_or("template has no material")?;
+    let material_template = materials.material_index_by_key(source_material).ok_or("template material missing")?.order();
+    let original = materials.materials[material_template].clone();
+    keys.clear();
+    for m in pack["materials"].as_array().ok_or("missing materials")? {
+        let name = format!("mc/{}",m["name"].as_str().ok_or("bad name")?);
+        let width=m["width"].as_u64().ok_or("bad width")? as u32;
+        let height=m["height"].as_u64().ok_or("bad height")? as u32;
+        let file=m["file"].as_str().ok_or("bad image path")?;
+        if file.contains('/') || file.contains('\\') { return Err("image must be beside chief.json".into()); }
+        let pixels=fs::read(path.join(file)).map_err(|e|e.to_string())?;
+        if pixels.len()!=width as usize*height as usize*4 { return Err("bad RGBA byte length".into()); }
+        let mut material=original.clone();material.name=AssetRef::Real(name.clone());
+        let binding=material.textures.iter_mut().find(|t|t.semantic==asset_material::TS_COLOR_MAP).ok_or("no diffuse binding")?;
+        let mut image=materials.images[binding.image.ok_or("missing diffuse image")?].clone();
+        let mut decoded=(**image.decoded.as_ref().ok_or("undecoded template image")?).clone();
+        decoded.data=Some(pixels);decoded.texture_descriptor.size=Extent3d{width,height,depth_or_array_layers:1};
+        decoded.texture_descriptor.format=TextureFormat::Rgba8Unorm;
+        decoded.texture_descriptor.mip_level_count=1;decoded.texture_view_descriptor=None;
+        image.name=AssetRef::Real(name.clone());image.width=width as u16;image.height=height as u16;image.level_count=1;
+        image.decoded=Some(Arc::new(decoded));image.payload=Arc::new(Vec::new());image.common_owned=false;image.decoded_by=None;image.decoded_variant=None;image.pending_decode=None;
+        binding.image=Some(materials.images.len());materials.images.push(image);
+        keys.push(Some(MaterialKey{namespace:material.namespace,name}));materials.materials.push(material);
+    }
+    s.positions=serde_json::from_value(pack["positions"].clone()).map_err(|e|e.to_string())?;
+    s.normals=serde_json::from_value(pack["normals"].clone()).map_err(|e|e.to_string())?;
+    s.uvs=serde_json::from_value(pack["uvs"].clone()).map_err(|e|e.to_string())?;
+    s.indices=serde_json::from_value(pack["indices"].clone()).map_err(|e|e.to_string())?;
+    let joints:Vec<[u16;4]>=serde_json::from_value(pack["joints"].clone()).map_err(|e|e.to_string())?;
+    let weights:Vec<[f32;4]>=serde_json::from_value(pack["weights"].clone()).map_err(|e|e.to_string())?;
+    let n=s.positions.len();
+    if n==0 || n>100000 || s.normals.len()!=n || s.uvs.len()!=n || joints.len()!=n || weights.len()!=n || s.indices.iter().any(|i|*i as usize>=n) {return Err("invalid Chief geometry".into());}
+    if joints.iter().flatten().any(|b|*b as usize>=s.bones.len()) || weights.iter().any(|w|w.iter().any(|v|!v.is_finite()||*v<0.) || (w.iter().sum::<f32>()-1.).abs()>0.01) {return Err("invalid Chief skin weights".into());}
+    s.vert_skin=joints.into_iter().zip(weights).map(|(bones,weights)|VertSkin{bones,weights,weight_u16:weights.map(|w|(w*65535.).round() as u16)}).collect();
+    s.colors=vec![[1.;4];n];
+    let bytes=fs::read(path.join(vertices)).map_err(|e|e.to_string())?;
+    if bytes.len()!=n*32{return Err("invalid packed vertex buffer".into());}
+    s.packed_vertices=bytes.chunks_exact(32).map(|b|b.try_into().unwrap()).collect();
+    let ranges:Vec<[usize;4]>=serde_json::from_value(pack["ranges"].clone()).map_err(|e|e.to_string())?;
+    if ranges.iter().any(|r|r[0]+r[1]>n||r[2]+r[3]>s.indices.len()) {return Err("invalid surface ranges".into());}
+    let count=ranges.len();s.surface_vertex_ranges=ranges.iter().map(|r|(r[0],r[1])).collect();s.surface_index_ranges=ranges.iter().map(|r|(r[2],r[3])).collect();
+    s.surface_materials=vec![None;count];s.surface_part_bits=vec![[0;6];count];s.surface_deformed=vec![Some(true);count];s.surface_vert_list_count=vec![Some(0);count];
+    // Native animation/culling needs the bones each surface actually uses.
+    for (surface, range) in ranges.iter().enumerate() {
+        for skin in &s.vert_skin[range[0]..range[0]+range[1]] {
+            for (&bone, &weight) in skin.bones.iter().zip(&skin.weights) {
+                if weight > 0. {
+                    let bone=usize::from(bone);
+                    s.surface_part_bits[surface][bone/32] |= 0x8000_0000 >> (bone%32);
+                }
+            }
+        }
+    }
+    // The last distance is the cutoff, not a switch threshold. A zero cutoff
+    // culls a single-LOD imported model from every camera position.
+    s.lod_surf_span=[(0,count as u16),(0,0),(0,0),(0,0)];s.lod=Some(ModelLodSelector::Iw4{lod_start:0,num_lods:1,lod_dist:[100_000.;4]});s.lod_smc=None;s.lod_part_bits=None;
+    s.rigid_verts=s.vert_skin.iter().filter(|v|v.weights[0]==1.).count();s.blend_verts=n-s.rigid_verts;s.radius=Some(90.);
+    let mut min=[f32::INFINITY;3];let mut max=[f32::NEG_INFINITY;3];for v in &s.positions{for k in 0..3{min[k]=min[k].min(v[k]);max[k]=max[k].max(v[k]);}}s.bounds=Some((min,max));
+    asset_model::link::stamp_xmodel_material_edges(keys,edges,&s.surface_materials,materials);
+    Ok(())
+}
diff --git a/crates/bootstrap/src/cinema.rs b/crates/bootstrap/src/cinema.rs
new file mode 100644
index 0000000..1de253f
--- /dev/null
+++ b/crates/bootstrap/src/cinema.rs
@@ -0,0 +1,89 @@
+//! Local JSON take driver. Uses the native simulation, animation and Metal renderer.
+use bevy::prelude::*;
+use frame::{AppScreen, ClientSet, RenderSet, UiDraw};
+use render_frontend::{FpvDrawPlan,prepare::scene::camera::{FlyCamera,FpvLens,SimCamera}};
+use render_frontend::adapters::anim::fpv_present::{FpvGeometrySet,FpvPlacementSet};
+use serde_json::Value;
+
+#[derive(Resource)]
+struct Take {
+    duration:f32, setup:String, events:Vec<(f32,String)>, camera:Vec<[f32;8]>,
+    motion:Vec<Vec<[f32;3]>>, stage:u8, stamp:f32, time:f32, cue:usize,
+}
+pub(crate) fn install(app:&mut App) {
+    let Some(path)=std::env::var_os("IW4L_CINEMA") else{return;};
+    let v:Value=serde_json::from_slice(&std::fs::read(path).expect("read native scene")).expect("parse native scene");
+    if v["version"]==2 {crate::cinema2::install(app,v);return;}
+    assert_eq!(v["version"],1,"native scene version");
+    let duration=v["duration"].as_f64().expect("scene duration") as f32;
+    assert!(duration.is_finite() && duration>0. && duration<=300.);
+    let camera:Vec<[f32;8]>=serde_json::from_value(v["camera"].clone()).expect("camera samples");
+    assert!(camera.len()>=(duration*60.) as usize+1 && camera.iter().flatten().all(|x|x.is_finite()));
+    let motion:Vec<Vec<[f32;3]>>=serde_json::from_value(v["motion"].clone()).expect("actor samples");
+    assert!(!motion.is_empty() && motion.iter().all(|f|f.len()==16 && f.iter().flatten().all(|x|x.is_finite())));
+    let events=v["events"].as_array().expect("scene events").iter().map(|e|(e["at"].as_f64().expect("cue time") as f32,e["command"].as_str().expect("cue command").to_owned())).collect();
+    app.insert_resource(Take{duration,setup:v["setup"].as_str().expect("scene setup").into(),events,camera,motion,stage:0,stamp:0.,time:0.,cue:0});
+    app.add_systems(Update,drive.in_set(ClientSet::Input));
+    app.add_systems(Update,move_camera.in_set(ClientSet::Present).before(RenderSet::FrontendPrepare));
+    app.add_systems(Update,hide_viewmodel.in_set(ClientSet::Present)
+        .after(FpvGeometrySet).after(FpvPlacementSet)
+        .after(frame::WorkerCmdSet::AddSceneEnt)
+        .in_set(render_frontend::assemble::ViewmodelDrawReady));
+}
+fn drive(time:Res<Time<Real>>,keys:Res<ButtonInput<KeyCode>>,screen:Res<AppScreen>,mut take:ResMut<Take>,mut queue:ResMut<console::ConsoleQueue>,mut world:Option<ResMut<net::AuthorityWorld>>,mut sim_camera:ResMut<SimCamera>,mut ui:ResMut<UiDraw>) {
+    let now=time.elapsed_secs();
+    if take.stage>=3 && keys.just_pressed(KeyCode::F9) {
+        let p=take.motion[0][0];
+        queue.push_line(&format!("release +speed_throw; force_spawn at {} {} {} 0; wait 0.5s; {}",p[0],p[1],p[2],take.setup));
+        take.stage=2;take.stamp=now;take.time=0.;sim_camera.enabled=true;ui.0=true;return;
+    }
+    if take.stage==0 {
+        if *screen!=AppScreen::InGame{return;}
+        queue.push_line("bot dummy 15");take.stage=1;take.stamp=now;return;
+    }
+    if take.stage==1 {
+        if !world.as_ref().is_some_and(|w|w.0.player_count()>=16) || now-take.stamp<2. {return;}
+        queue.push_line(&take.setup);take.stage=2;take.stamp=now;return;
+    }
+    if take.stage==2 {
+        if now-take.stamp<5. {return;}
+        take.stage=3;take.stamp=now;take.cue=0;ui.0=true;
+        diag::info!(Launch,"NATIVE CINEMA: starting 24-second take; 8 MW2 soldiers + 8 CE Spartans");
+    }
+    take.time=(now-take.stamp).min(take.duration);
+    sim_camera.enabled=take.time<5.8;sim_camera.freeze_fly=true;
+    if take.time>=5.8{ui.0=false;}
+    while take.cue<take.events.len() && take.events[take.cue].0<=take.time {
+        queue.push_line(&take.events[take.cue].1);take.cue+=1;
+    }
+    if let Some(world)=world.as_mut(){
+        let f=((take.time*10.) as usize).min(take.motion.len()-1);
+        for id in 1..16 {
+            world.0.cinema_keep_alive(sim::ClientId(id));
+            world.0.set_origin(sim::ClientId(id),take.motion[f][id as usize]);
+        }
+        if take.time<5.4 {world.0.cinema_keep_alive(sim::ClientId(0));}
+    }
+    if take.stage==3 && take.time>=take.duration {
+        take.stage=4;queue.push_line("screenshot");
+        diag::info!(Launch,"NATIVE CINEMA: take complete, holding final camera");
+    }
+}
+fn move_camera(take:Res<Take>,mut cameras:Query<&mut Transform,With<FlyCamera>>,mut lenses:Query<&mut Projection,With<FpvLens>>) {
+    if take.stage<3 || take.time<5.8{return;}
+    let sample=(take.time*60.).min((take.camera.len()-1) as f32);
+    let i=sample.floor() as usize;let a=take.camera[i];let b=take.camera[(i+1).min(take.camera.len()-1)];let u=sample-i as f32;
+    let p=std::array::from_fn::<_,8,_>(|k|a[k]+(b[k]-a[k])*u);
+    let mut pose=Transform::from_xyz(p[0],p[1],p[2]).looking_at(Vec3::new(p[3],p[4],p[5]),Vec3::Z);
+    pose.rotate_local_z(p[7]);
+    for mut camera in &mut cameras{*camera=pose;}
+    for mut projection in &mut lenses{if let Projection::Perspective(lens)=&mut *projection{lens.fov=p[6].to_radians();}}
+}
+fn hide_viewmodel(take:Res<Take>,mut plan:ResMut<FpvDrawPlan>){
+    if take.stage>=3 && take.time>=5.8 {
+        // Lighting finalization recomputes visible; preserve the decision in
+        // drawgun so it survives the rest of the native render pipeline.
+        plan.drawgun=Some(0);
+        plan.visible=false;
+    }
+}
diff --git a/crates/bootstrap/src/cinema2.rs b/crates/bootstrap/src/cinema2.rs
new file mode 100644
