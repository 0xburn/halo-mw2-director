+
+fn replace_mesh(s:&mut asset_model::ModelSkel, keys:&mut Vec<Option<MaterialKey>>, edges:&mut Vec<asset_model::AssetEdge<asset_model::MaterialSpace>>, materials:&mut asset_material::MaterialDefinitions, path:&Path, pack:&Value, vertices:&str)->Result<(),String>{
+    let source_material = keys.iter().flatten().next().ok_or("template has no material")?;
+    let material_template = materials.material_index_by_key(source_material).ok_or("template material missing")?.order();
+    let original = materials.materials[material_template].clone();
+    keys.clear();
+    for m in pack["materials"].as_array().ok_or("missing materials")? {
+        let name = format!("mc/{}",m["name"].as_str().ok_or("bad name")?);
+        let width=m["width"].as_u64().ok_or("bad width")? as u32;
+        let height=m["height"].as_u64().ok_or("bad height")? as u32;
+        let file=m["file"].as_str().ok_or("bad image path")?;
+        if file.contains('/') || file.contains('\\') { return Err("image must be beside chief.json".into()); }
+        let pixels=fs::read(path.join(file)).map_err(|e|e.to_string())?;
+        if pixels.len()!=width as usize*height as usize*4 { return Err("bad RGBA byte length".into()); }
+        let mut material=original.clone();material.name=AssetRef::Real(name.clone());
+        let binding=material.textures.iter_mut().find(|t|t.semantic==asset_material::TS_COLOR_MAP).ok_or("no diffuse binding")?;
+        let mut image=materials.images[binding.image.ok_or("missing diffuse image")?].clone();
+        let mut decoded=(**image.decoded.as_ref().ok_or("undecoded template image")?).clone();
+        decoded.data=Some(pixels);decoded.texture_descriptor.size=Extent3d{width,height,depth_or_array_layers:1};
+        decoded.texture_descriptor.format=TextureFormat::Rgba8Unorm;
+        decoded.texture_descriptor.mip_level_count=1;decoded.texture_view_descriptor=None;
+        image.name=AssetRef::Real(name.clone());image.width=width as u16;image.height=height as u16;image.level_count=1;
+        image.decoded=Some(Arc::new(decoded));image.payload=Arc::new(Vec::new());image.common_owned=false;image.decoded_by=None;image.decoded_variant=None;image.pending_decode=None;
+        binding.image=Some(materials.images.len());materials.images.push(image);
+        keys.push(Some(MaterialKey{namespace:material.namespace,name}));materials.materials.push(material);
+    }
+    s.positions=serde_json::from_value(pack["positions"].clone()).map_err(|e|e.to_string())?;
+    s.normals=serde_json::from_value(pack["normals"].clone()).map_err(|e|e.to_string())?;
+    s.uvs=serde_json::from_value(pack["uvs"].clone()).map_err(|e|e.to_string())?;
+    s.indices=serde_json::from_value(pack["indices"].clone()).map_err(|e|e.to_string())?;
+    let joints:Vec<[u16;4]>=serde_json::from_value(pack["joints"].clone()).map_err(|e|e.to_string())?;
+    let weights:Vec<[f32;4]>=serde_json::from_value(pack["weights"].clone()).map_err(|e|e.to_string())?;
+    let n=s.positions.len();
+    if n==0 || n>100000 || s.normals.len()!=n || s.uvs.len()!=n || joints.len()!=n || weights.len()!=n || s.indices.iter().any(|i|*i as usize>=n) {return Err("invalid Chief geometry".into());}
+    if joints.iter().flatten().any(|b|*b as usize>=s.bones.len()) || weights.iter().any(|w|w.iter().any(|v|!v.is_finite()||*v<0.) || (w.iter().sum::<f32>()-1.).abs()>0.01) {return Err("invalid Chief skin weights".into());}
+    s.vert_skin=joints.into_iter().zip(weights).map(|(bones,weights)|VertSkin{bones,weights,weight_u16:weights.map(|w|(w*65535.).round() as u16)}).collect();
+    s.colors=vec![[1.;4];n];
+    let bytes=fs::read(path.join(vertices)).map_err(|e|e.to_string())?;
+    if bytes.len()!=n*32{return Err("invalid packed vertex buffer".into());}
+    s.packed_vertices=bytes.chunks_exact(32).map(|b|b.try_into().unwrap()).collect();
+    let ranges:Vec<[usize;4]>=serde_json::from_value(pack["ranges"].clone()).map_err(|e|e.to_string())?;
+    if ranges.iter().any(|r|r[0]+r[1]>n||r[2]+r[3]>s.indices.len()) {return Err("invalid surface ranges".into());}
+    let count=ranges.len();s.surface_vertex_ranges=ranges.iter().map(|r|(r[0],r[1])).collect();s.surface_index_ranges=ranges.iter().map(|r|(r[2],r[3])).collect();
+    s.surface_materials=vec![None;count];s.surface_part_bits=vec![[0;6];count];s.surface_deformed=vec![Some(true);count];s.surface_vert_list_count=vec![Some(0);count];
