+pub fn arena_roam_candidates(graph: &NavGraph, from: [f32; 3], salt: u32) -> Vec<[f32; 3]> {
+    let Some(start) = nearest_within(graph, from, SNAP_IN) else {
+        return Vec::new();
+    };
+    let mut reachable = vec![false; graph.component_links.len()];
+    let mut pending = vec![graph.component[start as usize]];
+    while let Some(c) = pending.pop() {
+        if reachable[c as usize] {
+            continue;
+        }
+        reachable[c as usize] = true;
+        pending.extend_from_slice(&graph.component_links[c as usize]);
+    }
+    let mut lo = [f32::INFINITY; 3];
+    let mut hi = [f32::NEG_INFINITY; 3];
+    for p in &graph.nodes {
+        for k in 0..3 {
+            lo[k] = lo[k].min(p[k]);
+            hi[k] = hi[k].max(p[k]);
+        }
+    }
+    let mut floors = BTreeMap::<i32, usize>::new();
+    for p in &graph.nodes {
+        *floors.entry((p[2] / 24.0).round() as i32).or_default() += 1;
+    }
+    let main_floor = floors
+        .into_iter()
+        .max_by_key(|(_, count)| *count)
+        .map_or(from[2], |(z, _)| z as f32 * 24.0);
+    let angle = salt.wrapping_mul(3) as f32 * 2.399963;
+    let radius = ((hi[0] - lo[0]).min(hi[1] - lo[1]) * 0.2).clamp(160.0, 440.0);
+    let goal = [
+        (lo[0] + hi[0]) * 0.5 + angle.cos() * radius,
+        (lo[1] + hi[1]) * 0.5 + angle.sin() * radius,
+        from[2],
+    ];
+    let mut candidates: Vec<_> = graph
+        .nodes
+        .iter()
+        .enumerate()
+        .filter(|(i, p)| {
+            reachable[graph.component[*i] as usize]
+                && dist_xy(**p, from) > 160.0
+                && p[2] >= main_floor - 24.0
+                && p[2] <= main_floor + 96.0
+        })
+        .map(|(_, p)| *p)
+        .collect();
+    candidates.sort_by(|a, b| {
+        let score = |p: [f32; 3]| dist_xy(p, goal) + (p[2] - from[2]).abs() * 0.3;
+        score(*a).total_cmp(&score(*b))
+    });
+    let mut spread: Vec<[f32; 3]> = Vec::new();
+    for p in candidates {
+        if spread.iter().all(|q| dist_xy(*q, p) > 96.0) {
+            spread.push(p);
+        }
+        if spread.len() == 12 {
+            break;
+        }
+    }
+    spread
+}
